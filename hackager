# Lifted from umcares/inspect.py, whose docstring states the point better than
# a summary would: contact sheets exist "so a vision-capable model can literally
# look at the footage". `demo` used to end by telling you to watch the video --
# an instruction an LLM driving this tool cannot follow, which quietly broke the
# whole "any LLM can drive hackager alone" claim at the last step.

def contact_sheet(video, out, tiles=9, cols=3, width=480):
    """Tile N frames sampled evenly across the video into one image.
    Returns the timestamps, in tile order, so a reader can map "tile 5" back
    to a moment and say what is wrong with it."""
    dur = subprocess.run(["ffprobe", "-v", "error", "-show_entries", "format=duration",
                          "-of", "csv=p=0", str(video)], capture_output=True, text=True)
    try:
        total = float(dur.stdout.strip())
    except ValueError:
        return None, []
    # Skip the first and last 3%: tapes open on a clear and close on a prompt.
    stamps = [total * (0.03 + 0.94 * i / max(tiles - 1, 1)) for i in range(tiles)]
    with tempfile.TemporaryDirectory() as tmp:
        for i, ts in enumerate(stamps, 1):
            subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", f"{ts:.2f}",
                            "-i", str(video), "-frames:v", "1", "-vf", f"scale={width}:-2",
                            "-q:v", "5", f"{tmp}/{i:03d}.jpg"], capture_output=True)
        rows = (tiles + cols - 1) // cols
        res = subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-pattern_type", "glob",
                              "-i", f"{tmp}/*.jpg", "-filter_complex", f"tile={cols}x{rows}",
                              "-frames:v", "1", "-update", "1", "-q:v", "6", str(out)],
                             capture_output=True, text=True)
    if res.returncode != 0 or not out.is_file():
        return None, []
    return out, stamps


