            + "\n\n===== hackathon.json\n" + json.dumps(proj["manifest"], indent=2)
            + "\n\n===== package.json scripts (these exist; anything else probably does not)\n"
            + json.dumps(pkg, indent=2)
            + "\n\n===== verify: commands that were actually run and passed\n"
            + json.dumps(v.get("runs", []), indent=2)
            + "\n\n===== README.md\n" + read_if(path / "README.md", 20000)
            + "\n\n===== docs/PITCH.md (what the demo has to prove)\n"
            + read_if(path / "docs" / "PITCH.md", 8000)
            + "\n\n===== files\n" + clip(git(path, ["ls-files"]), 4000))


def tape_timeline(tape_text):
    """Cumulative timings from the tape's own Sleep/Type/TypingSpeed values --
    arithmetic, not an LLM guess, so the narration's cue times match the file
    that actually gets rendered."""
    speed_ms, t, rows, started = 50.0, 0.0, [], False
    for line in tape_text.splitlines():
        s = line.strip()
        if m := re.match(r"Set\s+TypingSpeed\s+(\d+(?:\.\d+)?)(ms|s)\b", s):
            speed_ms = float(m[1]) * (1000 if m[2] == "s" else 1)
        elif m := re.match(r"Sleep\s+(\d+(?:\.\d+)?)(ms|s)\b", s):
            t += float(m[1]) * (1 if m[2] == "s" else 0.001)
        elif m := re.match(r'Type\s+"(.*)"\s*$', s):
            t += len(m[1]) * speed_ms / 1000.0
            started = True
            rows.append((t, m[1]))
        elif started and s.startswith("#") and len(s.strip("# -")) > 2:
            # Only comments BETWEEN steps are cues. Every tape opens with a
            # header block explaining itself; those landed as 0:00 cues and
            # would have been narrated as if they were on screen.
            rows.append((t, s.strip("# -").strip()))
    return t, rows


