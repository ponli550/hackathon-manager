def git_author():
    # git config, not a placeholder -- a LICENSE with a fabricated name is
    # worse than one you have to fill in yourself.
    name = git(".", ["config", "user.name"]) or git(".", ["config", "--global", "user.name"])
    return name or "(unset -- run `git config --global user.name` first)"


def write_license(path, force=False):
    """Real MIT text, not a stub. Returns True if it wrote one."""
    lic = path / "LICENSE"
    if lic.exists() and not force:
        return False
    lic.write_text(MIT_LICENSE.format(year=datetime.now().year, author=git_author()))
    return True


