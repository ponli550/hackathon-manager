def clip(text, n):
    return text if len(text) <= n else text[:n] + f"\n\n[... clipped {len(text) - n} chars]"


def file_summary(path, top=40):
    """A tree an LLM can actually use, instead of a truncated file list.

    `git ls-files` clipped at 6000 chars turns a data-heavy repo into noise:
    Averis tracks 774 files (520 sample emails), so brief saw a fragment of
    one directory and hedged about whether the dataset was even present.
    Directory counts carry the shape in a fraction of the characters."""
    files = [f for f in git(path, ["ls-files"]).splitlines() if f]
    if not files:
        return "(nothing tracked yet)"
    dirs = {}
    root = []
    for f in files:
        if "/" in f:
            dirs.setdefault(f.rsplit("/", 1)[0], []).append(f)
        else:
            root.append(f)
    out = [f"{len(files)} tracked files"]
    out += sorted(root)[:top]
    for d, group in sorted(dirs.items(), key=lambda kv: -len(kv[1]))[:top]:
        sample = ", ".join(sorted(f.rsplit("/", 1)[1] for f in group)[:3])
        out.append(f"{d}/  ({len(group)} files, e.g. {sample})")
    return "\n".join(out)


def read_if(path, n=60000):
    try:
        return clip(path.read_text(errors="replace"), n)
    except OSError:
        return ""


def looks_like_doc(text, headings):
    """Is this reply the document that was asked for? The first `brief` run
    saved a one-line permission complaint as docs/BRIEF.md -- so a reply has
    to have the shape of a document (length, sections, the headings the
    prompt demanded) before it is allowed to become one."""
    low = text.lower()
    # re.M ^, not text.count("\n## "): a doc whose FIRST line is a heading
    # lost one from the tally, so a short, correct NARRATION.md with exactly
    # "## Shot list" + "## Script" scored 1 and was thrown away after paying
    # for it. Only bit documents with few headings, which is why RULES.md
    # (nine of them) never surfaced it.
    return (len(text) > 300 and len(re.findall(r"^## ", text, re.M)) >= 2
            and all(h.lower() in low for h in headings))


def llm_to_file(args, proj, step, prompt, out, summary, headings=(), validate=None):
    INTERNALS.mkdir(exist_ok=True)
    (INTERNALS / f"{proj['name']}-{step}.txt").write_text(prompt)
    if not args.yes and not confirm(summary, args.model):
        print("cancelled")
        return 2
    ok, text, cost, raw = run_llm(prompt, Path(proj["path"]), args.model, args.timeout)
    (INTERNALS / f"{proj['name']}-{step}.raw.jsonl").write_text(raw)
    check = validate or (lambda t: looks_like_doc(t, headings))
    if ok and not check(text):
        ok = False
        print(f"reply is not the document asked for (missing shape or headings "
              f"{list(headings)}); NOT written:", file=sys.stderr)
    if ok:
        out.write_text(text)
    print(text[:4000])
    print(f"\n-> {out if ok else '(not written)'}\n-- cost: ${cost:.4f}")
    return 0 if ok else 1


