                 "excluded already. Given the commit timeline below (grouped into work "
                 "sessions by time gap), write a candid narrative covering: what got built "
                 "first and why that ordering makes sense (or doesn't), how the work was "
                 "paced (one sprint vs. spread out, and what that implies), where the effort "
                 "concentrated, and one or two lessons a team building something similar "
                 "under the same time pressure should take from this. Under 50 lines. Do "
                 "not invent facts not in the log -- if something is unclear from the "
                 "commits alone, say so instead of guessing.")


def learn_prompt(proj):
    path = Path(proj["path"])
    commits = git_commits(path)
    sessions = dev_sessions(commits)
    md = [f"# {proj['name']} -- {len(commits)} commits (deployment-related ones excluded), "
          f"{len(sessions)} work session(s)"]
    for i, sess in enumerate(sessions, 1):
        start = datetime.fromtimestamp(sess[0][0]).strftime("%Y-%m-%d %H:%M")
        end = datetime.fromtimestamp(sess[-1][0]).strftime("%H:%M")
        md.append(f"\n## session {i}: {start} -> {end} ({len(sess)} commits)")
        for ts, subject in sess:
            md.append(f"- {subject}")
    return LEARN_SYSTEM + "\n\n---\n\n" + "\n".join(md)


