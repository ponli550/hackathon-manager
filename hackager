INTERNALS = SELF.parent / "prompts"


STACKS = [
    ("Cargo.toml", "Rust"),
    ("go.mod", "Go"),
    ("package.json", "JS/Node"),
    ("pyproject.toml", "Py"),
    ("setup.py", "Py"),
    ("requirements.txt", "Py"),
    ("Dockerfile", "Container"),
    ("docker-compose.yml", "Container"),
    ("extension/manifest.json", "Chrome-ext"),
]

TRACKS = ["devtools", "agent", "fintech", "gen-ai", "open-source", "design", "other"]


def git_env():
    """The environment with git's repo-pointing variables removed.

    `git -C <path>` does NOT win against an exported GIT_DIR/GIT_WORK_TREE --
    those take precedence, so every git call here silently retargets whatever
    repo the surrounding shell was pointed at. Caught for real: run from a
    shell holding the dotfiles bare repo in GIT_DIR, `hackager commit
    <project>` tried to commit that project's files into ~/.dotfiles, and only
    a stale index.lock stopped it. A tool that writes to git must say which
    repo itself, not inherit the answer."""
    env = os.environ.copy()
    for k in ("GIT_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY",
              "GIT_COMMON_DIR", "GIT_NAMESPACE"):
        env.pop(k, None)
    return env


def git(cwd, args):
    try:
        return subprocess.run(
            ["git", "-C", str(cwd), *args],
            capture_output=True,
            text=True,
            timeout=5,
            env=git_env(),
        ).stdout.strip()
    except (subprocess.SubprocessError, OSError):
        return ""


def scan_project(path):
    # .resolve() before anything reads p.name. Path(".").name is the empty
    # string and Path("..").name is literally "..", so `hackager slides .`
    # from inside a project wrote docs/.pptx -- a hidden dotfile, silently,
    # with no error and nothing to notice until you went looking for the deck.
    #
    # Fixed here rather than in slides because the name is used everywhere:
    # the prompt and raw-reply files under prompts/, <name>-verify.json,
    # <name>-build.txt, the board's first column and therefore the panel's
    # {row}. Every one of them was equally wrong for a relative path; slides
    # was just the one that left visible evidence.
    p = Path(path).resolve()
    md_files = [
        f for f in p.rglob("*.md")
        if "node_modules" not in f.parts and ".git" not in f.parts
    ]
    readme = p / "README.md"
    submission = p / "SUBMISSION.md"
    submission_docs = submission_files(p)
    manifest = p / MANIFEST

    def read(path, n=1):
        try:
            return " ".join(path.read_text(errors="replace").split("\n")[:n]).strip()
        except OSError:
            return ""

    demo = []
    for f in (readme, submission):
        try:
            demo += DEMO_RE.findall(f.read_text(errors="replace"))
        except OSError:
            continue
    # .strip() alone left a trailing ** on any URL written as markdown
    # bold (**https://...**) -- not visible on every row, only on ones short
    # enough that cmd_board's [:40] truncation does not already cut it off
    # first (VeriPay showed it, LabHack's longer domain coincidentally did not).
    demo = list(dict.fromkeys(url.strip().strip("*_") for url in demo))

    stack = []
    for fname, label in STACKS:
        if (p / fname).is_file():
            stack.append(label)

    branch = ""
    dirty = 0
    last_commit = ""
    remote = ""
    if (p / ".git").exists():
        branch = git(p, ["rev-parse", "--abbrev-ref", "HEAD"])
        dirty = len([l for l in git(p, ["status", "--porcelain"]).splitlines() if l])
        raw = git(p, ["log", "-1", "--format=%cI"])
        try:
            last_commit = datetime.fromisoformat(raw).strftime("%Y-%m-%d %H:%M")
        except ValueError:
            last_commit = raw
        # Not gated behind `init` -- a public repo is a fact about the
        # project whether or not anyone has run `init` to write a
        # hackathon.json yet. Was only ever fetched inside cmd_init, so
        # readiness's own "source" gate had nothing real to check against
        # for any project that hadn't been init'd -- which, until now, was
        # all six of them.
        remote = git(p, ["remote", "get-url", "origin"])

    out = {
        "name": p.name,
        "path": str(p),
        "git": (p / ".git").exists(),
        "branch": branch,
        "dirty": dirty,
        "last_commit": last_commit,
        "remote": remote,
        "readme_one_liner": read(readme),
        "readme_lines": None,
        "submission": submission.is_file() or bool(submission_docs),
        "submission_docs": [str(f) for f in submission_docs],
        "docs_articles": len([f for f in md_files
                              if f != readme and f != submission and f not in submission_docs]),
        "demo_links": demo,
        "stack": stack,
        "license": (p / "LICENSE").is_file() or (p / "LICENSE.md").is_file(),
        "manifest": load_manifest(manifest),
    }
    return out


def load_manifest(path):
    if not path.is_file():
        return {}
    try:
        return json.loads(path.read_text())
    except (OSError, json.JSONDecodeError):
        return {}


def readiness(proj):
    m = proj["manifest"] or {}
    # Was computed and passed back as `ok` by every caller and used by none --
    # dead output, the exact "not real logic" shape everything else here had.
    # A real gate now: source counts if a manifest says so explicitly, OR the
    # project actually has a git remote, which `scan_project` now checks
    # unconditionally rather than only when `hackathon.json` exists.
    steps = {
        "readme": bool(proj["readme_one_liner"]),
        "submission": bool(proj["submission"]),
        "demo": bool(proj["demo_links"]),
        "source": bool(m.get("source") or proj.get("remote")),
        "license": bool(proj["license"]),
        "clean": proj["dirty"] == 0,
    }
    done = sum(1 for v in steps.values() if v)
    state = "ready" if done == len(steps) else f"{done}/{len(steps)}"
    return state, steps


def discover(root):
    root = Path(root).expanduser()
    found = []
    for child in sorted(root.iterdir()):
        if not child.is_dir() or child.name.startswith("."):
            continue
        if child.name.lower() == SELF_DIR.lower():
            continue
        if child.name in ("node_modules", "venv", ".venv", "__pycache__"):
            continue
        if not any((child / s).exists() for s in ("README.md", MANIFEST, "package.json",
                                                  "pyproject.toml", "requirements.txt",
                                                  "Dockerfile", ".git")):
            continue
        found.append(child)
    return found


def cmd_scan(args):
    projects = [scan_project(p) for p in discover(root(args.dir))]
    manifest = {
        "tool": "hackager",
        "scanned_at": datetime.now().isoformat(timespec="seconds"),
        "root": str(Path(root(args.dir)).resolve()),
        "count": len(projects),
        "projects": projects,
    }
    if args.json:
        print(json.dumps(manifest, indent=2))
    else:
        for p in projects:
            state, steps = readiness(p)
            print(f"{p['name']:24} {state:12} docs={p['docs_articles']} dirty={p['dirty']} "
                  f"{','.join(p['stack']) or '-'}")
    return 0


def cmd_report(args):
    projects = [scan_project(p) for p in discover(root(args.dir))]
    rows = []
    for p in projects:
        state, steps = readiness(p)
        m = p["manifest"] or {}
        one = m.get("market") or ""
        rows.append({
            "name": p["name"],
            "state": state,
            "one_liner": m.get("one_liner") or p["readme_one_liner"],
            "market": one,
            "track": m.get("track", ""),
            "source": m.get("source") or p["remote"],
            "demo": (m.get("demo") or p["demo_links"][:1] or [""])[0] if (m.get("demo") or p["demo_links"]) else "",
            "missing": ", ".join(k for k, ok in steps.items() if not ok) or "-",
            "last_commit": p["last_commit"],
            "stack": ",".join(p["stack"]),
        })
    ready = [r for r in rows if r["state"] == "ready"]
    if args.json:
        print(json.dumps({"ts": datetime.now().isoformat(timespec="seconds"),
                          "total": len(rows), "ready": len(ready), "projects": rows}, indent=2))
        return 0
    print(f"{'PROJECT':24} {'STATE':12} MISSING / DETAIL")
    for r in rows:
        print(f"{r['name']:24} {r['state']:12} {r['missing']}")
        if r["one_liner"]:
            print(f"{'':24} {'':12} {r['one_liner'][:88]}")
    print(f"\n{len(ready)}/{len(rows)} submission-ready")
    return 0


