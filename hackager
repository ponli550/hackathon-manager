def cmd_board(args):
    projects = [scan_project(p) for p in discover(root(args.dir))]
    rows = []
    for p in projects:
        state, steps = readiness(p)
        m = p["manifest"] or {}
        missing = [k for k, v in steps.items() if not v]
        market = (m.get("market") or "-").replace("|", "\\|")[:40]
        demo = (m.get("demo") or (p["demo_links"] or ["-"])[0])[:40]
        dl = deadline_left(m)
        rows.append({"name": p["name"], "state": state, "missing": missing,
                     "market": market, "demo": demo,
                     "deadline": (dl["left"] if dl else "-"),
                     "deadline_at": (dl["deadline"] if dl else None)})

    # --json was accepted (it comes from the shared `common` parser every
    # subcommand takes) but had no effect at all -- the flag existed, nothing
    # behind it. `board --json --stdout` silently printed the same markdown as
    # a bare `board`. scan/report/check all honour --json for real; this is
    # the same shape, not a special case.
    if args.json:
        payload = {"ts": datetime.now().isoformat(timespec="seconds"),
                   "count": len(rows), "projects": rows}
        if args.stdout:
            print(json.dumps(payload, indent=2))
            return 0
        out = SELF.parent / "BOARD.json"
        out.write_text(json.dumps(payload, indent=2) + "\n")
        print(f"board -> {out}")
        return 0

    # Columns padded to width. Raw markdown pipes are fine for a file a
    # renderer will lay out, but this is read as plain text in a panel, where
    # a ragged table is just noise -- 'DeepTech' and 'Docs-of-Agents' put
    # every following column in a different place on each line.
    #
    # The panel's --row pattern has to tolerate the padding that follows;
    # hackager-popup matches '^| ([%w%-]+)%s*|' for exactly that reason. Any
    # change to this shape needs that pattern changed with it, which is the
    # argument against letting the engine pad tables instead: it would break
    # every panel's row matching at once, invisibly.
    # `deadline` sits third, before `missing`: when a narrow panel sheds
    # columns from the right it is the last thing a board should lose.
    header = ("project", "state", "deadline", "missing", "market", "demo")
    body = [[r["name"], r["state"], r["deadline"], ", ".join(r["missing"]) or "-", r["market"], r["demo"]]
            for r in rows]

    # Fit the panel. panvim hands every render command PANVIM_COLS and has
    # since it was written; nothing had ever read it, so this board was 153
    # columns wide in an 80-column panel and you scrolled sideways to reach
    # the state of your own projects.
    #
    # 80 of those 153 were `market` and `demo`, padded to 40 each while being
    # "-" in most rows. A column nobody has filled in is not information, so
    # it is dropped -- and comes back by itself the moment one row has a
    # value. project and state always stay: they are the board.
    # Only the panel is width-bound. BOARD.md is a file that markdown
    # renderers and GitHub lay out themselves, so fitting it to whatever
    # terminal happened to run `hackager board` made a tracked file's
    # contents depend on the environment: generated at 60 columns it lost the
    # demo column outright and ellipsised real market text, permanently, in
    # the copy that gets committed. The file gets every column at full width.
    cols = 10**6
    if args.stdout:
        cols = int(os.environ.get("PANVIM_COLS") or 0) or \
            shutil.get_terminal_size((100, 24)).columns
    keep = [i for i in range(len(header))
            if i < 2 or any(r[i] not in ("-", "") for r in body)]
    header = tuple(header[i] for i in keep)
    body = [[r[i] for i in keep] for r in body]

    widths = [len(h) for h in header]
    for r in body:
        widths = [max(w, len(c)) for w, c in zip(widths, r)]

    # Still over? Take it out of the widest column, which is the one with the
    # least to lose per character: an ellipsis on a long market description
    # beats a project name scrolled off the right edge.
    def total(ws):
        return sum(ws) + 3 * len(ws) + 1

    # Column 0 is never shrunk. It is the project name, and hackager-popup's
    # --row pattern reads it to build a path: truncating 'AmazonAppDev2026'
    # to 'AmazonAppDev2…' does not merely look wrong, it stops the pattern
    # matching at all ('…' is not a word character), so every row-keyed
    # command in the panel goes dead. Checked, before it shipped.
    while total(widths) > cols and max(widths[1:], default=0) > 8:
        i = 1 + widths[1:].index(max(widths[1:]))
        widths[i] -= 1
        body = [[(c[: widths[j] - 1] + "…") if j == i and len(c) > widths[j] else c
                 for j, c in enumerate(r)] for r in body]

    # Narrower than every column's floor: shed columns from the right rather
    # than overflow. A 60-column panel gets project/state/missing, which is
    # the board's actual question -- what is left to do -- and not a market
    # description squeezed to eight characters and scrolled off anyway.
    while total(widths) > cols and len(widths) > 3:
        widths.pop()
        header = header[:-1]
        body = [r[:-1] for r in body]

    def line(cells, dash=False):
        return "| " + " | ".join("-" * w if dash else c.ljust(w)
                                 for c, w in zip(cells, widths)) + " |"

    lines = ["# Hackathon board",
             f"_hackager {datetime.now().strftime('%Y-%m-%d %H:%M')}_",
             "",
             line(header),
             line(header, dash=True)]
    lines += [line(r) for r in body]
    text = "\n".join(lines) + "\n"
    if args.stdout:
        print(text, end="")
        return 0
    out = SELF.parent / "BOARD.md"
    out.write_text(text)
    print(f"board -> {out}")
    return 0


