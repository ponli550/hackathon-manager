# (classify these emails, compare these 7 fields, match sample_submission.json)
# and scores it with a formula -- there is no idea to choose, and proposing
# five would be inviting someone to ignore the brief. These markers are the
# ones an open-ended event's rules essentially never carry.
PRESCRIBED_RE = re.compile(
    r"macro-?f1|\bf1\b|precision/recall|\brmse\b|\bauc\b|leaderboard|ground truth|"
    r"submission\.json|sample_submission|score_cli|accuracy score|held-out|test set|"
    r"final score\s*=", re.I)


def prescribed_problem(proj):
    """(True, evidence) when the rules dictate the deliverable and score it."""
    rules = Path(proj["path"]) / "docs" / "RULES.md"
    try:
        text = rules.read_text(errors="replace")
    except OSError:
        return False, ""
    hits = sorted({h.lower() for h in PRESCRIBED_RE.findall(text)})
    return (len(hits) >= 2), ", ".join(hits[:5])


def idea_blocks(path):
    """The fenced json block closing each idea, in order. Parsed, not guessed:
    an idea whose block is malformed is dropped rather than half-applied.

    Falls back to BRIEF.md, which emits the same shape: on a prescribed
    problem there are no ideas to choose between, but the one-liner still has
    to reach the manifest without anyone retyping it."""
    for name in ("IDEAS.md", "BRIEF.md"):
        try:
            text = (path / "docs" / name).read_text()
        except OSError:
            continue
        if "```json" in text:
            break
    else:
        return []
    out = []
    for raw in re.findall(r"```json\s*(\{.*?\})\s*```", text, re.S):
        try:
            d = json.loads(raw)
        except json.JSONDecodeError:
            continue
        if isinstance(d, dict) and d.get("one_liner"):
            out.append(d)
    return out


