def write_pitch_scaffold(path, name, force=False):
    """A real skeleton with the judge-card's own headings, not fake content --
    every heading is a prompt to fill in, same honesty as init's blank
    manifest fields. Only written if NO submission-shaped doc exists yet;
    never overwrites real material someone already wrote."""
    docs = path / "docs"
    target = docs / "PITCH.md"
    if (submission_files(path) or (path / "SUBMISSION.md").is_file()) and not force:
        return None
    docs.mkdir(exist_ok=True)
    target.write_text(PITCH_SCAFFOLD.format(name=name, one_liner=f"({name} in one sentence)"))
    return target


def cmd_init(args):
    path = Path(args.project).expanduser()
    if not path.is_dir():
        print(f"no such project: {path}", file=sys.stderr)
        return 1
    target = path / MANIFEST
    if target.exists():
        print(f"{target} already exists", file=sys.stderr)
        return 1
    if not args.force:
        demo = " ".join(scan_project(path)["demo_links"])
        source = git(path, ["remote", "get-url", "origin"])
    else:
        demo, source = args.demo or "", args.source or ""
    payload = {
        "name": path.name,
        "one_liner": "",
        "problem": "",
        "market": "",
        # TRACKS existed and was never read anywhere -- a defined-but-dead
        # constant is the same "not real logic" shape as everything else
        # found here. --track is validated against it by argparse itself
        # (choices=TRACKS), so an invalid value never reaches this file.
        "track": args.track or "",
        "source": source,
        "demo": demo,
        "status": "draft",
        "event": "",
    }
    target.write_text(json.dumps(payload, indent=2) + "\n")
    print(f"wrote {target}")
    return 0


def cmd_new(args):
    """A brand-new project, from nothing to scannable -- the other half of
    "end to end" that init alone never covered: init only ever writes a
    manifest INTO a directory that already exists. Real, mechanical steps
    only: a git repo, a real MIT LICENSE, a README with the project's actual
    name in it, a hackathon.json, and a PITCH.md whose headings are the
    judge-card's own -- nothing here fabricates content a human has to write
    (the one-liner, the problem, the demo)."""
    path = Path(root(args.dir)).expanduser() / args.name
    if path.exists():
        print(f"{path} already exists", file=sys.stderr)
        return 1
    path.mkdir(parents=True)

    git(path, ["init", "-q"])

    readme = path / "README.md"
    readme.write_text(f"# {args.name}\n\n(one-liner goes here)\n\n"
                       f"## problem\n\n## how it works\n\n## running it locally\n")

    write_license(path)
    write_pitch_scaffold(path, args.name)

    manifest = {
        "name": args.name,
        "one_liner": "",
        "problem": "",
        "market": "",
        "track": args.track or "",
        "source": "",
        "demo": "",
        "status": "draft",
        "event": "",
    }
    (path / MANIFEST).write_text(json.dumps(manifest, indent=2) + "\n")

    git(path, ["add", "-A"])
    git(path, ["commit", "-q", "-m", "hackager new: scaffold"])

    print(f"new project -> {path}")
    print("  git repo, LICENSE, README.md, docs/PITCH.md, hackathon.json -- all real files, "
          "committed as one starting point.")
    print("  still yours to write: the one-liner, problem, demo, and a remote to push to.")
    return 0


def cmd_fix(args):
    """An EXISTING project (new or old, already on disk) toward real
    readiness -- but only the gates this can fix mechanically, without
    inventing content. A missing LICENSE gets a real one. A missing
    submission doc gets the judge-card skeleton, IF nothing submission-shaped
    already exists (never overwrites real material). A missing git repo gets
    `git init`. Everything else -- a one-liner, a problem statement, an actual
    deployed demo, committing whatever is dirty -- needs a human, and this
    says so instead of faking it."""
    path = Path(args.project).expanduser()
    if not path.is_dir():
        print(f"no such project: {path}", file=sys.stderr)
        return 1

    proj = scan_project(path)
    _, steps = readiness(proj)
    did, cant = [], []

    fresh_repo = not proj["git"]
    if not proj["git"]:
        git(path, ["init", "-q"])
        did.append(".git (git init)")

    if not steps["license"]:
        if write_license(path):
            did.append("LICENSE")
    if not steps["submission"]:
        target = write_pitch_scaffold(path, path.name)
        if target:
            did.append(str(target.relative_to(path)))

    if fresh_repo:
        # Only when the repo did not exist a moment ago: everything currently
        # untracked is either what fix() itself just wrote, or was already
        # sitting there before any of this ran -- nothing here is a change to
        # someone's IN-PROGRESS edit, because there was no history for an edit
        # to be in progress against. An existing repo never gets this: its
        # dirty state might be real uncommitted work, which is not fix()'s to
        # commit.
        git(path, ["add", "-A"])
        git(path, ["commit", "-q", "-m", "hackager fix: scaffold"])

    proj = scan_project(path)  # remote/dirty can only be known after the above

    if not steps["readme"]:
        cant.append("readme -- no one-liner to write for you; add one to README.md")
    if not steps["demo"]:
        cant.append("demo -- no URL to invent; deploy it, then it is picked up automatically")
    if not steps["source"] and proj["git"] and not proj["remote"]:
        cant.append("source -- git repo has no remote; `git remote add origin <url>` once pushed")
    if proj["dirty"]:
        cant.append(f"clean -- {proj['dirty']} uncommitted change(s); not committing on your behalf")

    if did:
        print("fixed: " + ", ".join(did))
    if cant:
        print("needs you: " + "; ".join(cant))
    if not did and not cant:
        print(f"{path.name}: already ready, nothing to fix")
    return 0


def cmd_check(args):
    projects = [scan_project(p) for p in discover(root(args.dir))]
    not_ready = [p for p in projects if readiness(p)[0] != "ready"]
    if args.json:  # JSON only -- see cmd_doctor
        print(json.dumps({"ready": len(projects) - len(not_ready),
                          "not_ready": [p["name"] for p in not_ready]}, indent=2))
        return 1 if not_ready else 0
    if not_ready:
        print("not submission-ready:", ", ".join(p["name"] for p in not_ready), file=sys.stderr)
        return 1
    print(f"all {len(projects)} projects submission-ready")
    return 0


