                       "tape's own real timings -> docs/NARRATION.md")
    p.add_argument("project"); llm_flags(p); p.set_defaults(fn=cmd_narrate)

    p = sub.add_parser("commit", parents=[common], help="git add -A && commit in the project (exit 2 if clean)")
    p.add_argument("project")
    p.add_argument("-m", "--message")
    p.add_argument("--no-check", action="store_true", help="skip the stale/failing verify note")
    p.set_defaults(fn=cmd_commit)

    p = sub.add_parser("build", parents=[common], help=f"LLM ({BUILD_LLM_MODEL}): build the project from docs/BRIEF.md, "
                       "unattended, inside the project only; writes docs/BUILD-REPORT.md")
    p.add_argument("project"); llm_flags(p, BUILD_LLM_MODEL, timeout=3600)
    p.add_argument("--budget", type=float, default=15.0, help="max USD to spend (default 15)")
    p.add_argument("--max-turns", type=int, default=300)
    p.set_defaults(fn=cmd_build)

    p = sub.add_parser("deploy", parents=[common], help="run the project's OWN deploy script (or its "
                       "wrangler/vercel config) and record the URL it prints as the demo; confirms first")
    p.add_argument("project")
    p.add_argument("-y", "--yes", action="store_true")
    p.add_argument("--timeout", type=int, default=900)
    p.set_defaults(fn=cmd_deploy)

    p = sub.add_parser("score", parents=[common], help="run the project's OWN grader against "
                       "submission.json (never invents scoring, never touches an answer key)")
    p.add_argument("project")
    p.add_argument("--submission", help="default: <project>/submission.json")
    p.add_argument("--timeout", type=int, default=120)
    p.set_defaults(fn=cmd_score)

    p = sub.add_parser("doctor", parents=[common], help="preflight every dependency; each failure "
                       "reports what it blocks and how to fix it (exit 1 if anything is missing)")
    p.set_defaults(fn=cmd_doctor)

    p = sub.add_parser("next", parents=[common], help="the one next command for this project, and why (--json)")
    p.add_argument("project")
    p.set_defaults(fn=cmd_next)

    p = sub.add_parser("publish", parents=[common], help="gh repo create + push; sets manifest source (confirms first)")
    p.add_argument("project")
    p.add_argument("--private", action="store_true")
    p.add_argument("-y", "--yes", action="store_true")
    p.set_defaults(fn=cmd_publish)

    p = sub.add_parser("schema", parents=[common], help="machine-readable contract: commands, args, writes, "
                       "exit codes, agent_contract")
    p.set_defaults(fn=lambda a: cmd_schema(a, ap))

    args = ap.parse_args()
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main())