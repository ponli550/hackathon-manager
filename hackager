DEMO_RE = re.compile(
    r"(https?://[^\s\)\]\"']+(?:youtu\.be/|youtube\.com|loom\.com|"
    # workers.dev added on hard evidence, not a guess: LabHack and VeriPay
    # both have a real, bolded, deployed demo link in their own README.md --
    # the exact file this regex scans -- that the old host list dropped
    # silently. Their readiness score read "missing: demo" for a demo that
    # was sitting in the one file already being read.
    r"vercel\.app|github\.io|streamlit\.app|huggingface\.co|workers\.dev|pages\.dev)"
    r"[^\s\)\]\"']*)",
    re.I,
)

SUBMISSION_DOCS = {"submission", "pitch", "demo", "deploy",
                   "devnet_proof", "runbook", "scaffold"}


def submission_files(p):
    """Every file that counts as submission material -- not one exact name.
    Checked in the project root AND its docs/ dir, since every real project
    that has this material keeps it in one or the other."""
    out = []
    for base in (p, p / "docs"):
        if not base.is_dir():
            continue
        for f in base.glob("*.md"):
            stem = f.stem.lower().replace("-", "_")
            if stem in SUBMISSION_DOCS:
                out.append(f)
    return out


def project_docs(proj):
    """Where hackager's OUTPUT for a project goes: the project's own docs/,
    not hackathon-manager/. Caught on the first real hackathon run (TenTen):
    `pitch` wrote cards/TenTen-Tencent-pitch.md under the manager, and the
    agent driving it then had to hand-copy that into TenTen's docs/PITCH.md
    and commit it -- the tool put the deliverable in the one place it could
    not be submitted from. Same for slides and pdf. The project is the unit
    of submission; its artifacts live with it."""
    d = Path(proj["path"]) / "docs"
    d.mkdir(exist_ok=True)
    return d


def pitch_card(proj):
    """The project's pitch doc, if it has one: docs/PITCH.md by preference
    (what new/fix scaffold), else whatever submission-shaped doc it does keep."""
    preferred = Path(proj["path"]) / "docs" / "PITCH.md"
    if preferred.is_file():
        return preferred
    found = submission_files(Path(proj["path"]))
    return found[0] if found else None


SCAFFOLD_MARK = "(who hurts: one named role"


def is_scaffold(path):
    """True if a PITCH.md is still the untouched skeleton new/fix wrote --
    safe to replace. Anything a human has edited is not."""
    try:
        return SCAFFOLD_MARK in path.read_text()
    except OSError:
        return False


