def pitch_prompt(proj):
    md = []
    meta = proj["manifest"] or {}
    if meta:
        md.append(f"# hackathon.json ({proj['name']})")
        md.append(json.dumps(meta, indent=2))

    readme = Path(proj["path"]) / "README.md"
    if readme.is_file():
        text = "\n".join(readme.read_text(errors="replace").split("\n")[:40])
        md.append("# README.md (first 40 lines)")
        md.append(text)

    # Not README.md + one literal SUBMISSION.md: every real submission-shaped
    # doc this project actually has, whatever it's named -- PITCH.md,
    # DEMO.md, DEPLOY.md, RUNBOOK.md, DEVNET_PROOF.md, SCAFFOLD.md all count.
    # The old version fed the LLM nothing but a README for 5 of 6 real
    # projects here, because none of them happen to have a SUBMISSION.md.
    for f in proj.get("submission_docs") or []:
        f = Path(f)
        if f.is_file():
            text = "\n".join(f.read_text(errors="replace").split("\n")[:60])
            md.append(f"# {f.name} (first 60 lines)")
            md.append(text)

    jf = Path(proj["path"]) / "docs" / "reference" / "judges.json"
    if jf.is_file():
        md.append("# The judging panel (write the card for these people; name no judge in the card itself)")
        md.append(jf.read_text(errors="replace"))
    return PITCH_SYSTEM + "\n\n---\n\n" + "\n\n".join(md)


DOC_ONLY = ("You have no tools and cannot create files. The caller saves your reply to the "
            "file named in the request. Reply with the finished document only -- no preface, "
            "no questions, no offer to do more.")

DEFAULT_LLM_MODEL = "sonnet"  # claude's own alias for the latest Sonnet; resolved
                              # and confirmed against a real call: canonicalModel
                              # came back "claude-sonnet-5".


def run_llm(prompt, cwd, model=None, timeout=300):
    """The one place that actually calls an LLM. `pitch` and `learn` both go
    through this -- "hackager is also an LLM wrapper" means one real wrapper
    both commands share, not two copies of logic that could quietly drift
    apart. Headless via the `claude` CLI itself (already authenticated on this
    machine, unlike opencode here, which had zero provider credentials
    configured -- `opencode models` listed 7 free-tier community models and
    nothing from Anthropic at all). One JSON object back, not an event
    stream. Returns (ok, result_text, cost_usd, raw_json)."""
    # --tools "" and --strict-mcp-config: this is a document generator. The
    # first `brief` run proved the need -- Sonnet read "write docs/BRIEF.md",
    # reached for a file tool, and replied "I need write permission approved"
    # -- and, checked separately, a bare `claude -p` here still carries the
    # user's claude.ai MCP connectors (it named Gmail). Neither belongs in a
    # pitch or rules call.
    res = subprocess.run(
        ["claude", "-p", "--model", model or DEFAULT_LLM_MODEL,
         "--output-format", "json", "--tools", "", "--strict-mcp-config",
         "--append-system-prompt", DOC_ONLY, prompt],
        capture_output=True, text=True, timeout=timeout, cwd=str(cwd),
    )
    try:
        obj = json.loads(res.stdout)
    except json.JSONDecodeError:
        return False, res.stderr.strip() or "claude produced no parseable output", 0.0, res.stdout
    ok = res.returncode == 0 and not obj.get("is_error")
    return ok, obj.get("result", ""), obj.get("total_cost_usd", 0.0), res.stdout


BUILD_LLM_MODEL = "opus"  # a long unattended coding run; sonnet stays the default elsewhere


def run_llm_agent(prompt, cwd, model, timeout, budget, max_turns):
    """Like run_llm, but the model may edit files and run commands in `cwd`,
    and progress is printed as it happens -- a 20-minute silent run reads as
    a hang. stream-json (checked against a real call): `assistant` events
    carry text/tool_use blocks, the final `result` carries total_cost_usd,
    num_turns, is_error. Permissions: acceptEdits plus an explicit tool
    allowlist, so nothing ever waits on a prompt headless mode cannot answer;
    no --add-dir, so file tools stay inside cwd. Budget and turn caps are
    passed to claude itself, not just checked afterwards."""
    cmd = ["claude", "-p", "--model", model, "--output-format", "stream-json", "--verbose",
           "--strict-mcp-config", "--permission-mode", "acceptEdits",
           "--allowedTools", "Read", "Edit", "Write", "Bash", "Glob", "Grep",
           "--max-budget-usd", str(budget), "--max-turns", str(max_turns), prompt]
    raw, result = [], None
    proc = subprocess.Popen(cmd, cwd=str(cwd), stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                            text=True)
    try:
        for line in proc.stdout:
            raw.append(line)
            try:
                ev = json.loads(line)
            except json.JSONDecodeError:
                continue
            if ev.get("type") == "assistant":
                for block in ev.get("message", {}).get("content", []):
                    if block.get("type") == "text" and block.get("text", "").strip():
                        print(block["text"].strip()[:600], flush=True)
                    elif block.get("type") == "tool_use":
                        inp = block.get("input", {})
                        what = inp.get("command") or inp.get("file_path") or inp.get("pattern") or ""
                        print(f"  [{block.get('name')}] {str(what)[:110]}", flush=True)
            elif ev.get("type") == "result":
                result = ev
        proc.wait(timeout=timeout)
    except subprocess.TimeoutExpired:
        proc.kill()
        return False, f"timed out after {timeout}s", 0.0, "".join(raw)
    if result is None:
        return False, proc.stderr.read().strip() or "claude produced no result event", 0.0, "".join(raw)
    ok = proc.returncode == 0 and not result.get("is_error")
    return ok, result.get("result", ""), result.get("total_cost_usd", 0.0), "".join(raw)


def confirm(summary, model, cost=None, llm=True):
    """A real prompt, not a --run flag to remember. This calls a paid API --
    a trivial two-word test call during development still cost $0.05, mostly
    context setup -- so "no need for dry-run" does not mean "no gate", it
    means the gate is here instead of a flag you had to already know about.

    llm=False for the outward-facing ones (deploy, publish): they spend
    nothing on a model, and printing "model: sonnet" over a `wrangler deploy`
    was simply untrue."""
    print(summary + (f"\nmodel: {model or DEFAULT_LLM_MODEL}" if llm else "")
          + (f"\n{cost}" if cost else ""))
    try:
        return input("proceed? [y/N] ").strip().lower() in ("y", "yes")
    except EOFError:
        return False


# Not "how it was hosted" -- keywords that show up when a commit is about
# getting the thing DEPLOYED/scheduled/running somewhere, not about what it
# does. Tested against XYZ's real log before use: matches exactly the 2 of 36
# commits that are actually about Trigger.dev/cron/secrets, none of the other
# 34 that are architecture, UI, or docs.
DEPLOY_RE = re.compile(
    r"deploy|hosting|wrangler|docker|render\.com|vercel|fly\.io|ci/cd|"
    r"release:|publish|trigger\.dev|cron|secrets? sync|worker becomes|scheduled sweep",
    re.I,
)


def git_commits(path, exclude_deploy=True):
    """Every commit as (unix_ts, subject), oldest first. Deployment-shaped
    ones dropped by default -- this is about how the THING got built, not how
    it got hosted."""
    raw = git(path, ["log", "--format=%at|%s", "--reverse"])
    out = []
    for line in raw.splitlines():
        if "|" not in line:
            continue
        ts, subject = line.split("|", 1)
        if exclude_deploy and DEPLOY_RE.search(subject):
            continue
        try:
            out.append((int(ts), subject))
        except ValueError:
            continue
    return out


def dev_sessions(commits, gap_minutes=90):
    """Group commits into work sessions -- a session ends when the gap to the
    next commit exceeds gap_minutes. A hackathon project built in one sitting
    shows as one session; one built over weeks shows as many, which is itself
    real signal about how it was made."""
    if not commits:
        return []
    sessions = [[commits[0]]]
    for prev, cur in zip(commits, commits[1:]):
        gap = (cur[0] - prev[0]) / 60
        if gap > gap_minutes:
            sessions.append([])
        sessions[-1].append(cur)
    return sessions


