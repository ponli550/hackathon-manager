# ---------------------------------------------------------------------------
# doctor: preflight. Shape taken from umcares/doctor.py, whose opening line is
# the whole argument -- "Every check here exists because that thing actually
# broke once" -- and whose Check carries a FIX, not just a verdict. Every
# entry below is something that failed during this tool's own development:
# pip refusing system Python (PEP 668), no PDF engine on the machine at all,
# opencode with no credentials, vhs needing ffmpeg and ttyd.
#
# Without this an agent meets each one serially, mid-workflow, after paying
# for the LLM steps that came before it.

class Check:
    def __init__(self, name, ok, detail="", fix="", needed_for=""):
        self.name, self.ok, self.detail, self.fix = name, ok, detail, fix
        self.needed_for = needed_for

    def as_dict(self):
        return {"check": self.name, "ok": self.ok, "detail": self.detail,
                "fix": self.fix, "needed_for": self.needed_for}


def doctor_checks():
    out = []
    for tool, fix, why in (
            ("claude", "npm i -g @anthropic-ai/claude-code, then log in",
             "rules, brief, build, review, pitch, learn, submission, demo, narrate"),
            ("git", "xcode-select --install", "everything"),
            ("gh", "brew install gh && gh auth login", "publish"),
            ("vhs", "brew install vhs", "demo"),
            ("ffmpeg", "brew install ffmpeg", "demo (vhs encodes with it; contact sheets)"),
            ("ttyd", "brew install ttyd", "demo (vhs drives a headless terminal with it)"),
            ("pandoc", "brew install pandoc", "pdf")):
        p = shutil.which(tool)
        out.append(Check(tool, bool(p), p or "not found", "" if p else fix, why))

    # The venv, not system python: pip refuses system Python here (PEP 668),
    # correctly, and --break-system-packages is not the answer.
    venv_fix = (f"cd {SELF.parent} && python3 -m venv .venv && "
                f".venv/bin/pip install weasyprint python-pptx")
    out.append(Check("pdftotext", bool(shutil.which("pdftotext")), shutil.which("pdftotext") or "missing",
                     "brew install poppler", "rules: reading a brief that arrived as a PDF"))
    out.append(Check("tesseract", bool(shutil.which("tesseract")), shutil.which("tesseract") or "missing",
                     "brew install tesseract", "rules: reading a brief that arrived as screenshots (optional; "
                     "paste the text into docs/reference/*.txt instead)"))
    out.append(Check(".venv", VENV_PY.exists(), str(VENV_PY) if VENV_PY.exists() else "missing",
                     "" if VENV_PY.exists() else venv_fix, "slides, pdf"))
    for mod, why in (("pptx", "slides"), ("weasyprint", "pdf")):
        if not VENV_PY.exists():
            out.append(Check(f".venv {mod}", False, "no venv", venv_fix, why))
            continue
        r = subprocess.run([str(VENV_PY), "-c", f"import {mod}"], capture_output=True)
        out.append(Check(f".venv {mod}", r.returncode == 0,
                         "importable" if r.returncode == 0 else "not installed",
                         "" if r.returncode == 0 else f"{VENV_PY.parent}/pip install "
                         f"{'python-pptx' if mod == 'pptx' else mod}", why))

    if shutil.which("gh"):
        r = subprocess.run(["gh", "auth", "status"], capture_output=True, text=True)
        ok = r.returncode == 0
        who = re.search(r"account (\S+)", r.stdout + r.stderr)
        out.append(Check("gh auth", ok, (who.group(1) if who and ok else "not logged in"),
                         "" if ok else "gh auth login", "publish"))
    root_dir = Path(default_root())
    out.append(Check("projects root", root_dir.is_dir(), str(root_dir),
                     "" if root_dir.is_dir() else f"mkdir -p {root_dir}", "scan, report, board"))
    return out


def cmd_doctor(args):
    checks = doctor_checks()
    bad = [c for c in checks if not c.ok]
    # --json means JSON on stdout and NOTHING else: a trailing human summary
    # makes the whole thing unparseable, which is exactly the bug this file
    # already carries a note about for `board --json`.
    if args.json:
        print(json.dumps({"ok": not bad, "checks": [c.as_dict() for c in checks]}, indent=2))
        return 1 if bad else 0
    for c in checks:
        print(f"  {'ok     ' if c.ok else 'MISSING'}  {c.name:<16} {c.detail[:52]}")
        if not c.ok:
            print(f"           needed for: {c.needed_for}")
            print(f"           fix: {c.fix}")
    print(f"doctor: {len(checks) - len(bad)}/{len(checks)} ok"
          + (f" -- broken: {', '.join(c.name for c in bad)}" if bad else ""))
    return 1 if bad else 0


# ---------------------------------------------------------------------------
# deploy: the OTHER half of the demo gate. `demo` makes a video; for a web
# app the judge wants a URL they can open. hackager does not reimplement any
# platform -- same principle as verify (runs the project's own test command)
# and demo (runs the project's own commands): it runs the project's own
# deploy script and reads the URL out of what that prints.

def deploy_plan(proj):
    """(cmd, label) or (None, why-not). Detection is from files that exist,
    never a guess -- and the project's own script wins over any platform CLI,
    because the script is what its author actually runs."""
    path = Path(proj["path"])
    scripts = {}
    if (path / "package.json").is_file():
        try:
            scripts = json.loads((path / "package.json").read_text()).get("scripts", {})
        except (OSError, json.JSONDecodeError):
            scripts = {}
    if "deploy" in scripts:
        return ["npm", "run", "deploy"], f"the project's own `deploy` script: {scripts['deploy']}"
    if any((path / f).is_file() for f in ("wrangler.jsonc", "wrangler.toml", "wrangler.json")):
        return ["npx", "wrangler", "deploy"], "wrangler config present, no deploy script"
    if (path / "vercel.json").is_file():
        return ["vercel", "--prod"], "vercel.json present, no deploy script"
    return None, ("no deploy script and no wrangler/vercel config -- nothing here says how this "
                  "project is meant to be deployed, and guessing would be worse than stopping")


def cmd_deploy(args):
    proj = scan_project(Path(args.project).expanduser())
    path = Path(proj["path"])
    cmd, why = deploy_plan(proj)
    if cmd is None:
        print(why, file=sys.stderr)
        print("if this project is not a deployable service, its demo is a video: "
              f"`hackager demo {path}`", file=sys.stderr)
        return 2
    if not shutil.which(cmd[0]):
        print(f"{cmd[0]} not installed", file=sys.stderr)
        return 1
    if not args.yes and not confirm(f"deploy: run `{' '.join(cmd)}` in {path}\n  ({why})",
                                    model=None, llm=False,
                                    cost="outward-facing: publishes to the internet and spends "
                                         "your own account's quota"):
        print("cancelled")
        return 2
    res = subprocess.run(cmd, cwd=str(path), capture_output=True, text=True, timeout=args.timeout)
    out = (res.stdout or "") + (res.stderr or "")
    print(out.strip()[-3000:])
    if res.returncode != 0:
        print("deploy failed", file=sys.stderr)
        return 1
    # The URL comes out of the deploy's own output or not at all -- never
    # composed from a project name and a guessed domain.
    urls = [u.strip().strip("*_,.") for u in DEMO_RE.findall(out)]
    if not urls:
        print("\ndeployed, but no URL matched in the output -- set it by hand:\n"
              f"  hackager set {path} demo=<url>", file=sys.stderr)
        return 1
    url = urls[-1]
    m = load_manifest(path / MANIFEST) or {"name": proj["name"]}
    m["demo"] = url
    for k in MANIFEST_KEYS:
        m.setdefault(k, "")
    (path / MANIFEST).write_text(json.dumps(m, indent=2) + "\n")
    print(f"\ndemo -> {url}  (recorded in hackathon.json)")
    print("open it yourself before submitting: a deploy that returns 500 still deploys.")
    return 0


# ---------------------------------------------------------------------------
# score: the project's own grader, if it has one. Same principle as verify and
# deploy -- run what the project already provides, never reimplement scoring.
# Distinct from both: the script commonly lives OUTSIDE the repo (an
# organizer's private bundle with an answer key, as on Averis x Monash) and
# must never be assumed to be safe to commit -- score does not touch git.

SCORE_HINTS = ("score_cli.py", "score.py", "scripts/score.py", "grade.py", "evaluate.py")


def score_plan(proj):
    """(cmd, label) or (None, why-not). An organizer's grader bundle is
    commonly extracted beside the repo, not inside it -- as with
    sdoc-hackathon-docker/server/score_cli.py, two levels below the project
    root -- so this walks a few levels deep, name-matched only, never
    entering .git/node_modules/.venv (a name check alone is not enough: the
    first version checked one level and missed a grader sitting one deeper)."""
    path = Path(proj["path"])
    skip = {".git", "node_modules", ".venv", "__pycache__", "dist", "build"}
    hits = []
    for depth in range(4):
        for f in path.glob("/".join(["*"] * depth + ["*"]) if depth else "*"):
            if f.is_file() and f.name in SCORE_HINTS and not (skip & set(p.name for p in f.parents)):
                hits.append(f)
        if hits:
            break
    if not hits:
        return None, "no score_cli.py / score.py / grade.py / evaluate.py found in the project or "\
                     "nearby -- if the organizers gave you a grader under another name, run it "\
                     "yourself; this only matches those names"
    return ["python3", str(hits[0]), "SUBMISSION_PATH"], f"found {hits[0].relative_to(path)}"


def cmd_score(args):
    proj = scan_project(Path(args.project).expanduser())
    path = Path(proj["path"])
    sub = Path(args.submission).expanduser() if args.submission else path / "submission.json"
    if not sub.is_file():
        print(f"no submission file at {sub} -- build one first, or pass --submission", file=sys.stderr)
        return 1
    cmd, why = score_plan(proj)
    if cmd is None:
        print(why, file=sys.stderr)
        return 2
    cmd = [str(sub) if c == "SUBMISSION_PATH" else c for c in cmd]
    print(f"{why}: {' '.join(cmd)}")
    res = subprocess.run(cmd, cwd=str(Path(cmd[1]).parent), capture_output=True, text=True,
                         timeout=args.timeout)
    print((res.stdout or res.stderr).strip())
    return res.returncode


def cmd_publish(args):
    """Create the GitHub repo and push -- the `source` gate, and the one step
    here that is outward-facing, so it confirms first. Uses `gh`, which must
    already be logged in; nothing here stores credentials."""
    path = Path(args.project).expanduser()
    proj = scan_project(path)
    if proj["remote"]:
        print(f"already has a remote: {proj['remote']}")
        return 2
    if not shutil.which("gh"):
        print("gh not installed", file=sys.stderr)
        return 1
    vis = "--private" if args.private else "--public"
    if not args.yes and not confirm(f"publish: gh repo create {path.name} {vis} --source {path} --push",
                                    model=None, llm=False, cost="pushes this repo to GitHub"):
        print("cancelled")
        return 2
    res = subprocess.run(["gh", "repo", "create", path.name, vis, "--source", str(path), "--push"],
                         capture_output=True, text=True)
    if res.returncode != 0:
        print(res.stderr.strip(), file=sys.stderr)
        return 1
    url = git(path, ["remote", "get-url", "origin"]).removesuffix(".git")
    m = load_manifest(path / MANIFEST)
    if m and not m.get("source"):
        m["source"] = url
        (path / MANIFEST).write_text(json.dumps(m, indent=2) + "\n")
    print(f"published -> {url}")
    return 0


# ---------------------------------------------------------------------------
# next: the driver. One step at a time, in the order a project actually
# needs, so an LLM confined to this tool never has to know the workflow --
# it runs `next`, runs what it says, runs `next` again. --json for machines.

PROBLEM_WORDS = re.compile(r"person|problem|loss|who hurts|owner|bookkeeper|accountant|customer|patient|"
                           r"student|teacher|farmer|nurse|driver|shop|pain|costs?|loses?|told|chase", re.I)
MECHANISM_WORDS = re.compile(r"\b(mcp|api|server|tool|verifier|dashboard|model|llm|agent|framework|sdk)\b", re.I)


def pitch_problem_first(card):
    """Why a finished entry still lost: the pitch opened on the mechanism. Returns a complaint
    (str) or '' when the card's first content slide is about a person and a loss. Checked
    on the card, not the deck: the deck is built from it. Slide 1 is the cover; slide 2 must
    name who hurts; slides 2-3 must carry a number and must not name the machinery."""
    try:
        text = card.read_text(errors="replace")
    except OSError:
        return "no pitch card"
    secs = re.split(r"^## +", text, flags=re.M)[1:]
    if len(secs) < 3:
        return "pitch card has fewer than three sections"
    title2, body2 = (secs[1].split("\n", 1) + [""])[:2]
    first_two = secs[1] + "\n" + secs[2]
    if not PROBLEM_WORDS.search(title2 + " " + body2[:200]):
        return f"slide 2 ({title2.strip()[:40]!r}) is not about a person or a problem -- the deck must open on who hurts"
    if not re.search(r"\d", first_two):
        return "slides 2-3 carry no number -- a loss without a number is a feeling"
    hit = MECHANISM_WORDS.search(first_two)
    if hit:
        return f"slides 2-3 name the machinery ({hit.group(0)!r}) -- keep the first two slides about the person"
    return ""


CUE_RE = re.compile(r"^\*\*(\d+):(\d\d)\s*[—-]+\s*\[?([^\]*]*)\]?\*\*\s*(.*)$", re.M)
SCREEN_WORDS = re.compile(r"\b(demo|screen|click|paste|run the|tool|mcp|url|slide \d|browser|terminal|type the)\b", re.I)
GENERIC_QUESTIONS = [
    "Who exactly has this problem, and what does one instance of it cost them?",
    "What did you build that someone could not get by calling an API themselves?",
    "Who pays for this, and why would they pay you rather than their existing vendor?",
    "What breaks first if a hundred people use it tomorrow?",
    "What did you cut, and what would you build next week?",
    "Show me the moment it was wrong. What happened?",
]


def cmd_archive(args):
    """Snapshot an agent run as evidence: every out/ directory under the project, copied to
    runs/NN-<date>-<label>/ with a README listing what was kept and, when the project has a
    scorer and an exceptions.json, the score. Invented by hand at 2 a.m. the first time;
    `git add -A` had been sweeping the agent's scratch files into history instead."""
    path = Path(args.project).expanduser()
    outs = [d for d in path.rglob("out") if d.is_dir() and ".git" not in d.parts and "node_modules" not in d.parts
            and ".venv" not in d.parts and "runs" not in d.parts]
    if not outs:
        print("no out/ directory to archive", file=sys.stderr); return 2
    runs = path / "runs"; runs.mkdir(exist_ok=True)
    n = 1 + max([int(d.name.split("-")[0]) for d in runs.iterdir() if d.is_dir() and d.name[:2].isdigit()] or [0])
    label = re.sub(r"[^A-Za-z0-9]+", "-", args.label).strip("-").lower() or "run"
    dest = runs / f"{n:02d}-{datetime.now().strftime('%Y-%m-%d')}-{label}"
    kept = []
    for o in outs:
        rel = o.relative_to(path)
        target = dest / (rel.parent.name + "-out" if rel.parent != path else "out")
        shutil.copytree(o, target)
        kept += [str(f.relative_to(dest)) for f in target.rglob("*") if f.is_file()]
    lines = [f"# Run {n} -- {datetime.now().strftime('%Y-%m-%d %H:%M')} -- {args.label}", "",
             args.note or "(what happened, which server, what it proved and what it exposed)", "",
             "## Kept"] + [f"- {k}" for k in sorted(kept)]
    scorer = path / "datagen" / "score.py"
    exc = next((f for f in dest.rglob("exceptions.json")), None)
    if scorer.is_file() and exc:
        res = subprocess.run([sys.executable, str(scorer), str(exc)], capture_output=True, text=True, cwd=path)
        lines += ["", "## Score", "```", (res.stdout + res.stderr).strip(), "```"]
    (dest / "README.md").write_text("\n".join(lines) + "\n")
    print(f"-> {dest.relative_to(path)}  ({len(kept)} files)")
    return 0


def cmd_judges(args):
    """The panel as data. Two judges can score the same pitch differently; a founder who
    runs an accounting firm and a research engineer hear different openers. Stored in
    docs/reference/judges.json; `pitch` feeds it to the coach and `rehearse` drills from it."""
    proj = scan_project(Path(args.project).expanduser())
    ref = project_docs(proj) / "reference"; ref.mkdir(parents=True, exist_ok=True)
    jf = ref / "judges.json"
    judges = []
    if jf.is_file():
        try:
            judges = json.loads(jf.read_text())
        except json.JSONDecodeError:
            judges = []
    for spec in args.add or []:
        parts = [x.strip() for x in spec.split("|")]
        if len(parts) < 2:
            print(f"expected 'Name | Role[, Org] | lens', got {spec!r}", file=sys.stderr)
            return 1
        j = {"name": parts[0], "role": parts[1], "lens": parts[2] if len(parts) > 2 else ""}
        judges = [x for x in judges if x.get("name") != j["name"]] + [j]
    if args.add:
        jf.write_text(json.dumps(judges, indent=2) + "\n")
    if args.json:
        print(json.dumps(judges, indent=2)); return 0
    if not judges:
        print("no judges recorded -- `hackager judges <proj> --add 'Name | Role | lens'`"); return 2
    for j in judges:
        print(f"  {j['name']:<28} {j['role']:<40} {j.get('lens','')}")
    return 0


def cmd_rehearse(args):
    """Say it out loud, timed, before anyone else hears it. The weekend this was written, a
    finished entry opened on the mechanism, skipped the written problem opener, and lost on
    'tell us more about the problem'. Reads docs/PITCH_SCRIPT.md (or the pitch card), checks
    the shape (total length; the first 30 seconds are a person and a loss, not a screen), then
    runs the cues as a timer and a judge-question drill. Writes docs/REHEARSAL.md. Exit 2 when
    the shape or the timing fails: a valid 'not yet'."""
    proj = scan_project(Path(args.project).expanduser())
    docs = project_docs(proj)
    script = docs / "PITCH_SCRIPT.md"
    card = pitch_card(proj)
    if not script.is_file():
        if card is None or is_scaffold(card):
            print("no docs/PITCH_SCRIPT.md and no pitch card -- `hackager pitch` first", file=sys.stderr)
            return 1
        print(f"no docs/PITCH_SCRIPT.md; checking the card's shape only", file=sys.stderr)
    problems = []
    cues = []
    if script.is_file():
        text = script.read_text(errors="replace")
        for m in CUE_RE.finditer(text):
            at = int(m.group(1)) * 60 + int(m.group(2))
            cues.append({"at": at, "cue": m.group(3).strip(), "line": m.group(4).strip()})
        if not cues:
            problems.append("no timed cues found (expected lines like `**0:20 — [slide 2]** ...`)")
        else:
            last = cues[-1]["at"]
            if last > args.limit:
                problems.append(f"last cue at {last//60}:{last%60:02d} is past the {args.limit//60}:{args.limit%60:02d} limit")
            # spoken words only: a cue like "[slide 1 up, dark]" is a stage direction, not a screen
            opener = " ".join(c["line"] for c in cues if c["at"] < 30)
            hit = SCREEN_WORDS.search(opener)
            if hit:
                problems.append(f"the first 30 seconds mention {hit.group(0)!r}: open on a person and a loss, no screen, no tool")
            if not re.search(r"\d", opener):
                problems.append("the first 30 seconds carry no number: say what it costs")
    if card is not None and not is_scaffold(card):
        c = pitch_problem_first(card)
        if c:
            problems.append("card: " + c)
    judges = []
    jf = docs / "reference" / "judges.json"
    if jf.is_file():
        try:
            judges = json.loads(jf.read_text())
        except json.JSONDecodeError:
            pass
    questions = list(GENERIC_QUESTIONS)
    rules = docs / "RULES.md"
    if rules.is_file():
        crit = re.search(r"## Judging.*?(?=^## |\Z)", rules.read_text(errors="replace"), re.S | re.M)
        if crit:
            for line in crit.group(0).splitlines():
                line = line.strip("-* ").strip()
                if 12 < len(line) < 140 and not line.startswith("#"):
                    questions.append(f"The rules score '{line[:100]}'. Where is that in your two minutes?")
    for j in judges[:8]:
        who = j.get("name", "a judge"); lens = j.get("lens") or j.get("role") or ""
        if lens:
            questions.append(f"{who} ({lens}) asks: what in this is new to someone who does {lens.lower()} every day?")

    report = [f"# Rehearsal -- {proj['name']} -- {datetime.now().strftime('%Y-%m-%d %H:%M')}", ""]
    if problems:
        report.append("## Shape")
        report += [f"- {p}" for p in problems]
        report.append("")
    for p in problems:
        print(f"shape: {p}", file=sys.stderr)
    if args.check:
        report.append("(shape check only; no timed run)")
        (docs / "REHEARSAL.md").write_text("\n".join(report) + "\n")
        return 2 if problems else 0

    # the timed run: one cue at a time, Enter to advance, the clock does not lie
    print("\nRehearsal. Press Enter at each cue when you reach it; say the words out loud.\n")
    import time
    t0 = None; timings = []
    for c in cues:
        label = f"[{c['at']//60}:{c['at']%60:02d}] {c['cue']}"
        try:
            input(f"  -> {label}\n     {c['line'][:160]}\n     (Enter when you start this cue) ")
        except EOFError:
            break
        now = time.monotonic()
        if t0 is None:
            t0 = now
        actual = int(now - t0)
        drift = actual - c["at"]
        timings.append({"cue": c["cue"], "planned": c["at"], "actual": actual, "drift": drift})
        print(f"     {actual//60}:{actual%60:02d} ({'+' if drift >= 0 else ''}{drift}s)")
    if timings:
        total = timings[-1]["actual"]
        report.append("## Timing")
        report += [f"- {t['cue']}: planned {t['planned']//60}:{t['planned']%60:02d}, said at {t['actual']//60}:{t['actual']%60:02d} ({'+' if t['drift']>=0 else ''}{t['drift']}s)" for t in timings]
        over = total > args.limit
        report.append(f"- last cue reached at {total//60}:{total%60:02d}" + (" -- OVER" if over else ""))
        report.append("")
        if over:
            problems.append(f"ran to {total//60}:{total%60:02d}, over the limit")
    # the drill: answer out loud; the point is hearing yourself not have an answer
    print("\nJudge drill. Answer each out loud, then Enter.\n")
    report.append("## Questions drilled")
    import random
    random.shuffle(questions)
    for q in questions[: args.questions]:
        try:
            input(f"  ? {q}\n    ")
        except EOFError:
            break
        report.append(f"- {q}")
    report.append("")
    report.append("verdict: " + ("NOT YET -- " + "; ".join(problems) if problems else "ready"))
    (docs / "REHEARSAL.md").write_text("\n".join(report) + "\n")
    print(f"\n-> {docs / 'REHEARSAL.md'}")
    return 2 if problems else 0


def deadline_left(m):
    """The submission deadline as time remaining, or None. Read from the
    manifest, never guessed: `next` prints it first because the one thing an
    agent driving this tool got wrong for hours was the clock."""
    raw = (m or {}).get("deadline")
    if not raw:
        return None
    try:
        dt = datetime.fromisoformat(raw)
    except ValueError:
        return None
    if dt.tzinfo is None:
        return None
    now = datetime.now(dt.tzinfo)
    secs = int((dt - now).total_seconds())
    if secs <= 0:
        text = "PASSED"
    else:
        d, r = divmod(secs, 86400); h, r = divmod(r, 3600); mi = r // 60
        text = (f"{d}d {h}h" if d else f"{h}h {mi:02d}m")
    return {"deadline": dt.isoformat(), "seconds_left": secs, "left": text,
            "local": dt.strftime("%a %d %b %H:%M %z"), "urgent": 0 < secs < 2 * 3600}


def next_step(proj):
    path = Path(proj["path"])
    m = proj["manifest"] or {}
    docs = path / "docs"
    _, gates = readiness(proj)
    name = proj["name"]

    def step(cmd, why, human=False, step_name=""):
        return {"project": name, "step": step_name or cmd.split()[1], "cmd": cmd, "why": why,
                "needs_human": human}

    if not proj["git"] or not gates["license"]:
        return step(f"hackager fix {path}", "no git repo / LICENSE yet -- mechanical, free")
    if not reference_pages(proj):
        if m.get("event"):
            return step(f"hackager fetch {m['event']} {path} --follow",
                        "rules not fetched yet; --follow gets the rules/terms/dates pages too")
        return step(f"hackager set {path} event=<hackathon url>",
                    "no hackathon URL known; only a human knows which event this is for", human=True)
    if not (docs / "RULES.md").is_file():
        return step(f"hackager rules {path}", "pages fetched but not distilled (LLM, sonnet)")
    # An existing project brought in from outside (or built before `build`
    # existed) has its spec in the code; a brief is only for what is not
    # built yet. Without this, `next` sent a finished repo back to `brief`.
    has_code = bool(proj["stack"]) or any((path / d).is_dir() for d in ("src", "app", "lib", "cmd"))
    # Choosing WHAT to build comes before specifying how. Five candidates and
    # a pick beat one proposal: a single suggestion invites a rubber stamp,
    # and most of these events require the idea to be the entrant's own.
    if not has_code and not m.get("one_liner"):
        fixed, evidence = prescribed_problem(proj)
        if fixed:
            # Must still check for the brief, or this branch loops forever on
            # a project that already has one -- which it did, immediately.
            if not (docs / "BRIEF.md").is_file():
                return step(f"hackager brief {path}", "the rules dictate the deliverable and score "
                            f"it ({evidence}) -- there is no idea to choose, so brief scopes the "
                            "build straight from the spec")
            return step(f"hackager pick {path} 1", "the spec is scoped; `pick` copies the one-liner "
                        "out of docs/BRIEF.md's Manifest block so it does not have to be retyped",
                        human=True)
        if not (docs / "IDEAS.md").is_file():
            return step(f"hackager ideas {path}", "nothing decided yet -- 5 candidate ideas read from "
                        "the rules (LLM, sonnet); you choose, the tool does not rank them")
        return step(f"hackager pick {path} <n>", f"docs/IDEAS.md has the candidates (`hackager pick "
                    f"{path}` lists them) -- choosing is yours, and under most rules the idea must "
                    "be the entrant's own", human=True)
    if not has_code and not (docs / "BRIEF.md").is_file():
        return step(f"hackager brief {path}", "idea chosen, no build spec yet (LLM, sonnet)")
    empty = [k for k in ("problem", "market", "track") if not m.get(k)]
    if empty:
        hint = ("`hackager pick` fills these from the chosen idea"
                if (docs / "IDEAS.md").is_file() else "describe what the existing code does")
        return step(f"hackager set {path} " + " ".join(f"{k}=..." for k in empty),
                    f"manifest fields empty: {', '.join(empty)} -- {hint}", human=True)
    if not has_code:
        if proj["dirty"]:
            return step(f"hackager commit {path} -m \"docs: rules, brief, manifest\"",
                        "build starts from a clean tree; commit the docs first")
        return step(f"hackager build {path}", f"spec exists, no code -- long agentic run (LLM, "
                    f"{BUILD_LLM_MODEL}), confirms budget first")
    v = last_verify(proj)
    if v is None:
        return step(f"hackager verify {path}", "code changed since last verify (or never verified) -- runs "
                    "the project's own build/tests, free")
    if not verify_ok(v):
        bad = [k for k, ok in v["checks"].items() if not ok]
        return step(f"hackager build {path}", f"verify failing: {', '.join(bad)} -- another build pass, or "
                    "fix by hand and `hackager verify` again", human=True)
    review = docs / "REVIEW.md"
    # Stale = older than the last COMMIT. Not older than the .git directory:
    # scan_project's own `git status` refreshes .git/index on every call, so
    # that comparison made every review look stale and `next` re-ran the
    # LLM review 11 times in a row on the first real drive-through.
    last_code_commit = int((code_head(path).split() or ["", "0"])[-1])
    if not review.is_file() or review.stat().st_mtime < last_code_commit:
        return step(f"hackager review {path}", "verified but not judged against the rules yet (LLM, sonnet)")
    card = pitch_card(proj)
    if card is None or is_scaffold(card):
        return step(f"hackager pitch {path}", "PITCH.md is still the skeleton (LLM, sonnet)")
    complaint = pitch_problem_first(card)
    if complaint:
        return step(f"(edit {card.relative_to(path)}: {complaint})",
                    "judges score the why before the how; this gate exists because a working entry lost on "
                    "exactly this", human=True, step_name="pitch")
    if not (docs / "SUBMISSION.md").is_file():
        return step(f"hackager submission {path}", "no form answers drafted (LLM, sonnet)")
    if not (docs / f"{name}.pptx").is_file():
        return step(f"hackager slides {path}", "no deck yet -- free")
    if not (docs / f"{name}-slides.pdf").is_file():
        return step(f"hackager pdf {path} --slides", "no slide deck as PDF yet (the form usually wants one) -- free")
    script = docs / "PITCH_SCRIPT.md"
    reh = docs / "REHEARSAL.md"
    if script.is_file() and (not reh.is_file() or reh.stat().st_mtime < script.stat().st_mtime
                             or "verdict: ready" not in reh.read_text(errors="replace")):
        return step(f"hackager rehearse {path}", "the script has not been said out loud, timed, since it last "
                    "changed -- the one step no tool can do for you, and the one this gate exists for", human=True)
    if proj["dirty"]:
        return step(f"hackager commit {path}", f"{proj['dirty']} uncommitted change(s)")
    if not gates["source"]:
        return step(f"hackager publish {path}", "no public repo yet (confirms before pushing)")
    if not gates["demo"]:
        # A deployable service and a CLI want different demos. Ask the project
        # which it is rather than assuming every entry is a video: three of
        # these projects ship as Workers and their demo is a URL a judge opens.
        cmd, _ = deploy_plan(proj)
        if cmd:
            return step(f"hackager deploy {path}", "this project has its own deploy path, so its "
                        "demo is a live URL -- deploy records it in the manifest (confirms first)")
        media = sorted((docs / "media").glob("demo.*")) if (docs / "media").is_dir() else []
        if not media:
            return step(f"hackager demo {path}", "no demo video yet -- writes a VHS tape from this "
                        "project's own commands and renders it (real footage, re-renderable)")
        if not (docs / "NARRATION.md").is_file():
            return step(f"hackager narrate {path}", "footage exists but no spoken script, cued to "
                        "the tape's real timings (LLM, sonnet)")
        return step("(watch docs/media/demo.mp4, upload to YouTube/Vimeo, then "
                    "`hackager set ... demo=<url>`)",
                    "the footage is rendered; uploading it is outward-facing and yours",
                    human=True, step_name="demo")
    return step("(submit on the hackathon site using docs/SUBMISSION.md)",
                "all gates green", human=True, step_name="done")


def cmd_next(args):
    proj = scan_project(Path(args.project).expanduser())
    s = next_step(proj)
    dl = deadline_left(proj["manifest"])
    if dl:
        s["deadline"] = dl
    if args.json:
        print(json.dumps(s, indent=2))
    else:
        if dl:
            # Red under two hours, when every step has to be weighed against
            # pressing submit; a tool that knows the deadline should not let
            # the agent guess it.
            line = f"deadline: {dl['local']} -- " + ("PASSED" if dl["left"] == "PASSED" else f"{dl['left']} left")
            print(f"\033[31m{line}\033[0m" if dl["urgent"] or dl["left"] == "PASSED" else line)
        elif s["step"] != "done":
            print("deadline: not set -- `hackager set <proj> deadline=2026-10-11T09:30+08:00`")
        print(s["cmd"])
        print(f"  why: {s['why']}" + ("  [needs a human]" if s["needs_human"] else ""))
    return 0 if s["step"] != "done" else 2


