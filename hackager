              file=sys.stderr)
    res = subprocess.run(["vhs", str(tape.relative_to(path))], cwd=str(path),
                         capture_output=True, text=True, timeout=args.render_timeout)
    if res.returncode != 0:
        print((res.stderr or res.stdout).strip()[-2000:], file=sys.stderr)
        return 1
    made = sorted(f for f in media.glob("demo.*") if f.suffix in (".gif", ".mp4"))
    for f in made:
        print(f"  {f.stat().st_size:>9} bytes  {f.relative_to(path)}")
    if not made:
