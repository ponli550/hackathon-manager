    sub = ap.add_subparsers(dest="cmd", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="emit JSON envelopes")

    p = sub.add_parser("scan", parents=[common], help="discover projects and extract signals")
    p.add_argument("dir", nargs="?", default=DEFAULT)
    p.set_defaults(fn=cmd_scan)

