# demo: the video. Until now this was the one artifact the tool told you to
# go and make yourself. The pattern is lifted from Xendit/docs, which does it
# properly: a VHS tape (charmbracelet/vhs) drives real project commands in a
# headless terminal and encodes the frames, so re-rendering cannot drift away
# from what the code does -- unlike a screen capture of someone typing, which
# has to be re-shot by hand every time the code changes. Its media/README puts
# the rule plainly: "The tape is re-rendered rather than edited, so the
# recording cannot drift away from what the code actually does."

# A terminal recording only *is* the demo when the project runs in a terminal.
# The Amazon rules want "footage that shows the Project functioning on the
# device for which it was built" -- for a Fire TV or Ring entry a asciicast of
# npm test is not that, and shipping one would fail the requirement while
# looking finished.
DEVICE_RE = re.compile(r"fire\s?tv|vega\s?os|fire\s?os|\bring\b|alexa\+? device|apple watch|"
                       r"android|ios\b|mobile app|react native|browser extension", re.I)


def looks_terminal_demoable(proj):
    """(ok, reason). Honest about the cases where a tape is the wrong medium."""
    path = Path(proj["path"])
    hay = " ".join([read_if(path / "README.md", 8000),
                    json.dumps(proj["manifest"] or {}),
                    read_if(path / "docs" / "RULES.md", 4000)])
    hit = DEVICE_RE.search(hay)
    if hit:
        return False, (f"this project mentions {hit.group(0)!r} -- if the rules ask for footage of "
                       f"it running on that device, a terminal recording does not satisfy them")
    return True, ""


