def cmd_schema(args, ap=None):
    """The contract, derived from argparse itself so it cannot drift from
    the real flags -- plus what each command writes and whether it spends."""
    cmds = {}
    for action in ap._subparsers._group_actions:
        # add_parser(help=...) lands on the subparsers action's choice list,
        # not on the sub-parser's .description -- reading the latter gave an
        # empty help for all 24 commands on the first check of this output.
        helps = {c.dest: c.help or "" for c in getattr(action, "_choices_actions", [])}
        for name, sp in action.choices.items():
            meta = CMD_META.get(name, {})
            args = []
            for a in sp._actions:
                if a.dest == "help":
                    continue
                entry = {"flags": a.option_strings or [a.dest], "help": a.help or "",
                         "required": bool(a.required) if a.option_strings else a.nargs not in ("?", "*")}
                if a.choices:
                    entry["choices"] = list(a.choices)
                if a.default not in (None, argparse.SUPPRESS, DEFAULT, False):
                    entry["default"] = a.default
                args.append(entry)
            cmds[name] = {"help": helps.get(name, ""), "args": args,
                          "writes": meta.get("writes", []), "llm": meta.get("llm")}
    out = {"tool": "hackager", "version": 2,
           "exit_codes": {"0": "ok", "1": "error", "2": "valid no (cancelled / nothing to do / done)"},
           "workflow": ["fix", "set event=", "fetch --follow", "rules", "brief", "set one_liner= ...",
                        "commit", "build", "verify", "review", "pitch", "submission", "slides", "pdf",
                        "commit", "publish", "(human: demo video)", "(human: submit)"],
           "agent_contract": AGENT_CONTRACT, "commands": cmds}
    print(json.dumps(out, indent=2))
    return 0


def default_root():
