    path meaningful only inside their own Docker image. What is reused is the
    actual mechanism -- pandoc with weasyprint as the PDF engine -- pointed at
    whatever file you give it."""
    if not need_venv():
        return 1
    src = Path(args.target).expanduser()
    if src.is_dir():
        # A project: its pitch doc, so the panel can say `pdf <project>` and
        # the PDF lands beside the markdown, inside the project.
        proj = scan_project(src)
        card = pitch_card(proj)
        if card is None or is_scaffold(card):
            print(f"no filled-in pitch doc in {proj['name']}/docs to render", file=sys.stderr)
            return 1
        src = card
    if not src.is_file():
        print(f"no such file: {src}", file=sys.stderr)
        return 1
    if args.slides:
        # The form said "presentation slides, PDF format"; `slides` makes a pptx and
        # there was no LibreOffice to convert it. One 16:9 page per `##`, images,
        # `::stamp WORD` and `::cat mood` directives, rendered by weasyprint directly.
        out = Path(args.out).expanduser() if args.out else src.parent / f"{src.parent.parent.name}-slides.pdf"
        res = subprocess.run([str(VENV_PY), str(SELF.parent / "lib" / "slides_pdf.py"), str(src), str(out)],
                             capture_output=True, text=True)
        print((res.stdout or res.stderr).strip())
        return 0 if res.returncode == 0 else 1
    out = Path(args.out).expanduser() if args.out else src.with_suffix(".pdf")
    weasyprint = SELF.parent / ".venv" / "bin" / "weasyprint"
    res = subprocess.run(["pandoc", "--pdf-engine", str(weasyprint), "-f", "markdown",
                          str(src), "-o", str(out)], capture_output=True, text=True)
    if res.returncode != 0:
        print(res.stderr.strip(), file=sys.stderr)
        return 1
    print(f"{out}")
    return 0


def fetch_url(url, timeout=15):
    """Stdlib only -- no FETCH'EM. That project is a Docker/Celery scraping
    service built for adversarial targets: proxy rotation, CAPTCHA solving,
    residential proxies, honeypot detection, none of it configured with
    credentials here, and none of it needed to read a public university
    hackathon page. Pulling in celery+redis+playwright+cloudscraper for a
    plain GET would be pretending to a capability this has no way to
    exercise. A real User-Agent (the same one FETCH'EM's own WebFetcher
    sends) is the one thing worth carrying over."""
    import urllib.request
    req = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
    })
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.status, r.read().decode(errors="replace")


def meta_text(s):
    """title + description/og/keywords meta. On a client-rendered SPA this is
    often the ONLY prose in the served HTML -- the Averis x Monash site is a
    single JS bundle whose 40KB of markup yielded 62 characters of body text,
    while its meta tags carried the theme, the team size and the eligibility.
    Thrown away before; it is the only thing a plain GET can see there."""
    out = []
    if m := re.search(r"<title[^>]*>(.*?)</title>", s, re.S | re.I):
        out.append(html_mod.unescape(re.sub(r"\s+", " ", m[1])).strip())
    for tag in re.findall(r"<meta\s+[^>]*>", s, re.I):
        name = re.search(r'(?:name|property)\s*=\s*["\']([^"\']+)', tag, re.I)
        content = re.search(r'content\s*=\s*["\']([^"\']*)', tag, re.I)
        if not name or not content or not content[1].strip():
            continue
        if re.search(r"description|keywords|^og:|^twitter:", name[1], re.I):
            val = html_mod.unescape(content[1]).strip()
            line = f"{name[1]}: {val}"
            if line not in out:
                out.append(line)
    return "\n".join(out)


def html_to_text(s):
    """Visible text only, stdlib. Every page this has been pointed at so far
    (Sime Darby, Devpost) was server-rendered, so this is what a reader sees;
    a client-rendered SPA comes out near-empty, which is itself the signal --
    so the meta block goes in front, and cmd_fetch says when that is all
    there was."""
    head = meta_text(s)
    s = re.sub(r"<(script|style|noscript|svg)[^>]*>.*?</\1>", " ", s, flags=re.S | re.I)
    s = re.sub(r"<br\s*/?>|</(p|div|li|h\d|tr|section|article|header|footer)>", "\n", s, flags=re.I)
    s = re.sub(r"<[^>]+>", " ", s)
    s = html_mod.unescape(s)
    lines = [re.sub(r"[ \t]+", " ", l).strip() for l in s.splitlines()]
    body = "\n".join(l for l in lines if l)
    return (head + "\n\n" + body).strip() if head else body


# The pages behind a hackathon site's buttons -- rules, terms, dates, FAQ --
# are where the requirements actually live; the landing page is marketing.
# Both real runs (Sime Darby: /register + /terms-and-conditions; Devpost:
# /rules + /details/dates + /resources) needed them, and both times the
# links had to be grepped out of the HTML by hand.
FOLLOW_RE = re.compile(r"rules|terms|conditions|dates|schedule|timeline|resources|faq|"
                       r"prizes|judg|criteria|submission|register|eligib|requirement|"
                       r"guideline|brief|challenge", re.I)


def linked_pages(base_url, body, limit=12):
    from urllib.parse import urljoin, urlsplit, urlunsplit
    base = urlsplit(base_url)
    seen, out = {urlunsplit(base._replace(query="", fragment="")).rstrip("/")}, []
    for href in re.findall(r'href=["\']([^"\'#]+)', body):
        u = urlsplit(urljoin(base_url, html_mod.unescape(href)))
        if u.netloc != base.netloc or not FOLLOW_RE.search(u.path):
            continue
        clean = urlunsplit(u._replace(query="", fragment="")).rstrip("/")
        if clean in seen or re.search(r"\.(css|js|png|jpg|svg|ico|pdf)$", clean, re.I):
            continue
        seen.add(clean)
        out.append(clean)
        if len(out) >= limit:
            break
    return out


def save_page(proj, url, timeout):
    status, body = fetch_url(url, timeout)
    # Raw page under the project it is evidence for -- a hackathon's own
    # rules/terms belong with the entry being prepared for it, not in a
    # shared fetched/ bucket under the manager where nothing can cite it.
    fetched = project_docs(proj) / "reference"
    fetched.mkdir(exist_ok=True)
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", url.split("//", 1)[-1])[:80]
    out = fetched / f"{name}.html"
    out.write_text(body)
    # A .txt beside it so the next reader -- `hackager read`, `rules`, or an
    # LLM confined to this tool -- never has to strip HTML itself.
    text = html_to_text(body)
    out.with_suffix(".txt").write_text(text)
    # out.stat().st_size, not len(body): body is decoded text, a character
    # count, and multi-byte characters made it undercount the real file.
    print(f"{status} {out.stat().st_size} bytes -> {out}")
    # A near-empty extraction from a large page is a client-rendered site, and
    # saying nothing about it is the dangerous case: `rules` would go on to
    # distil a blank page into a confident-looking document.
    if len(body) > 4000 and len(text) < len(body) * 0.05:
        print(f"  warning: only {len(text)} chars of text from {len(body)} of HTML -- this page "
              f"renders its content in JavaScript.\n"
              f"  a plain GET cannot see it. Save the page from a browser into "
              f"{out.parent}/ as .txt, or paste the rules there by hand.", file=sys.stderr)
    return body


def cmd_fetch(args):
    proj = scan_project(Path(args.project).expanduser())
    try:
        body = save_page(proj, args.url, args.timeout)
    except Exception as e:
        print(f"fetch failed: {e}", file=sys.stderr)
        return 1
    if args.follow:
        links = linked_pages(args.url, body)
        print(f"following {len(links)} linked page(s) on the same site:")
        for u in links:
            try:
                save_page(proj, u, args.timeout)
            except Exception as e:
                print(f"  {u}: {e}", file=sys.stderr)
    return 0


# Data, not documentation. A downloaded challenge bundle carries both, and
# feeding 60 sample emails to `rules` would cost real money to learn nothing.
BUNDLE_DATA_DIRS = {"attachments", "inbox", "data", "samples", "node_modules", "__pycache__"}


def reference_pages(proj):
    """Everything under docs/reference that DESCRIBES the challenge: fetched
    pages, plus any README/markdown inside a bundle downloaded by hand.

    The bundle half was missing: the Averis problem statement arrived as a zip
    whose README.md is the actual brief, one directory down, and `rules` could
    not see it -- so a project with the real spec on disk still distilled the
    landing page's SEO tags. Backfills .txt for any .html saved before .txt
    existed."""
    ref = Path(proj["path"]) / "docs" / "reference"
    if not ref.is_dir():
        return []
    for h in ref.glob("*.html"):
        t = h.with_suffix(".txt")
        if not t.is_file():
            t.write_text(html_to_text(h.read_text(errors="replace")))
    # The brief arrives as screenshots and PDFs as often as pages: Hackerdorm's came as
    # WhatsApp images of slides, read by hand into a .txt at the time. Convert what can be
    # converted, once, beside the original; what cannot is named so the human knows.
    for f in list(ref.glob("*.pdf")):
        t = f.with_suffix(".pdf.txt")
        if not t.is_file() and shutil.which("pdftotext"):
            subprocess.run(["pdftotext", "-layout", str(f), str(t)], capture_output=True)
    for f in [x for ext in ("png", "jpg", "jpeg", "webp", "tif", "tiff") for x in ref.glob(f"*.{ext}")]:
        t = f.with_suffix(f.suffix + ".txt")
        if not t.is_file() and shutil.which("tesseract"):
            subprocess.run(["tesseract", str(f), str(t.with_suffix("")), "--psm", "6"], capture_output=True)
    out = list(ref.glob("*.txt")) + list(ref.glob("*.md"))
    for f in ref.rglob("*.md"):
        if f.parent != ref and not (BUNDLE_DATA_DIRS & set(p.name.lower() for p in f.parents)):
            out.append(f)
    return sorted(set(out))


def readable_pages(proj):
    """Everything in this project an agent may need to READ: the docs hackager
    itself wrote, plus the fetched pages.

    The docs half was missing, and `next` was the thing that exposed it -- it
    says "docs/BRIEF.md has a ## Manifest block to take them from" while
    `read` served only docs/reference/*.txt, so an agent confined to this tool
    could not follow the tool's own instruction. Anything hackager tells you
    to read, it has to be able to show you."""
    docs = Path(proj["path"]) / "docs"
    out = sorted(docs.glob("*.md")) if docs.is_dir() else []
    return out + reference_pages(proj)


def cmd_read(args):
    """Print one of this project's docs, or a fetched page, as text.
    Without a name, list what there is."""
    proj = scan_project(Path(args.project).expanduser())
    pages = readable_pages(proj)
    if not pages:
        print("nothing to read yet -- `hackager fetch <url> <project> --follow`", file=sys.stderr)
        return 2
    if not args.page:
        for f in pages:
            n = f.stat().st_size
            print(f"{n:>8}  {f.stem}" + ("   (empty -- nothing to read)" if n == 0 else ""))
        return 0
    hits = [f for f in pages if args.page.lower() in f.stem.lower()]
    if len(hits) > 1:  # an exact stem match beats a substring: "pitch" over "pitch.draft"
        exact = [f for f in hits if f.stem.lower() == args.page.lower()]
        hits = exact or hits
    if len(hits) != 1:
        print(f"{'no' if not hits else len(hits)} page(s) match {args.page!r}: "
              + ", ".join(f.stem for f in hits), file=sys.stderr)
        return 1
    print(hits[0].read_text())
    return 0


def cmd_set(args):
    """Manifest fields from the command line -- the only way an LLM confined
    to this tool can record the one-liner, problem, market, track, or the
    hackathon's URL (`event`). Validated: an unknown key or a bad track is an
    error, never a silent typo in the JSON."""
    path = Path(args.project).expanduser()
    target = path / MANIFEST
    m = load_manifest(target) or {"name": path.name}
    changed = []
    for kv in args.pairs:
        if "=" not in kv:
            print(f"expected key=value, got {kv!r}", file=sys.stderr)
            return 1
        k, v = kv.split("=", 1)
        if k not in MANIFEST_KEYS:
            print(f"unknown field {k!r}; known: {', '.join(MANIFEST_KEYS)}", file=sys.stderr)
            return 1
        if k == "track" and v and v not in TRACKS:
            print(f"track must be one of {', '.join(TRACKS)}", file=sys.stderr)
            return 1
        if k == "deadline" and v:
            # ISO 8601 WITH an offset. A deadline without a timezone is how a
            # whole night gets misreported: the clock was read in UTC and the
            # offset added twice, and 06:42 was called 09:15.
            try:
                dt = datetime.fromisoformat(v)
            except ValueError:
                print("deadline must be ISO 8601 with an offset, e.g. 2026-10-11T09:30+08:00", file=sys.stderr)
                return 1
            if dt.tzinfo is None:
                print("deadline needs a timezone offset, e.g. ...T09:30+08:00", file=sys.stderr)
                return 1
            v = dt.isoformat()
        if m.get(k) != v:
            m[k] = v
            changed.append(k)
    for k in MANIFEST_KEYS:
        m.setdefault(k, "")
    target.write_text(json.dumps(m, indent=2) + "\n")
    print(("set " + ", ".join(changed)) if changed else "no change")
    return 0


def cmd_commit(args):
    """`git add -A && git commit` for the project. Exit 2 when there is
    nothing to commit -- a valid "no", not an error."""
    path = Path(args.project).expanduser()
    if not (path / ".git").exists():
        print("not a git repo -- `hackager fix` first", file=sys.stderr)
        return 1
    if not git(path, ["status", "--porcelain"]):
        print("nothing to commit")
        return 2
    # Default message names what changed, not "checkpoint" -- a log full of
    # timestamps says nothing when someone reads it later.
    # split(None, 1), not a fixed slice: git() strips its output, so the
    # leading space of a " M path" line is already gone by here -- a fixed
    # [3:] produced "ocs/" for docs/ on the first real run.
    changed = sorted({(p := l.split(None, 1)[-1]).split("/")[0] + ("/" if "/" in p else "")
                      for l in git(path, ["status", "--porcelain"]).splitlines() if l.strip()})
    # Agents leave scripts, payloads and chunk files beside the inputs they were given;
    # `git add -A` then sweeps them into history. Twice, on one project, before this
    # warning existed. A workspace holds inputs and out/; name anything else.
    untracked = [l for l in git(path, ["ls-files", "--others", "--exclude-standard"]).splitlines() if l.strip()]
    debris = [u for u in untracked if re.match(r"workspace[^/]*/", u)
              and not re.match(r"workspace[^/]*/(invoices/|out/|bank_statement\.csv$)", u)]
    debris += [u for u in untracked if re.search(r"(^|/)(\.workbuddy-ai|chunks|batches)/", u)
               or re.search(r"(^|/)(set_workspace.*\.json|gen_payload.*\.py|mcp_client\.py)$", u)]
    debris = sorted(set(debris))
    if debris and not args.no_check:
        print(f"note: {len(debris)} untracked file(s) look like an agent's scratch, not source -- "
              f"e.g. {debris[0]}" + (f" (+{len(debris)-1} more)" if len(debris) > 1 else "") +
              ". Add them to .gitignore or remove them; committing anyway.", file=sys.stderr)
    # What a pre-commit hook would have told you, without being one: the
    # cached verify result, which is free to read. It WARNS rather than
    # blocks -- committing work-in-progress that does not build yet is
    # legitimate, and a gate you have to fight is a gate people disable.
    # Only speaks up when code changed; a docs-only commit cannot break it.
    if not args.no_check and any(not c.startswith("docs/") and c != MANIFEST for c in changed):
        v = last_verify(scan_project(path))
        # Keyed on the last code COMMIT, last_verify cannot see uncommitted
        # edits -- it called a tree "verified" that had been edited since.
        # The verify's own wall-clock time against the files' mtimes can.
        if v is not None:
            try:
                ran = datetime.fromisoformat(v["at"]).timestamp()
                newest = max((f.stat().st_mtime for f in (path / c.rstrip("/") for c in changed)
                              if f.exists() and f.is_file()), default=0)
                if newest > ran:
                    v = None
            except (ValueError, KeyError, OSError):
                pass
        if v is None:
            print("note: code has changed since the last verify -- "
                  f"`hackager verify {path}` before this is judged", file=sys.stderr)
        elif not verify_ok(v):
            bad = [k for k, ok in v["checks"].items() if not ok]
            print(f"note: last verify was FAILING ({', '.join(bad)}) -- committing anyway",
                  file=sys.stderr)
    git(path, ["add", "-A"])
    msg = args.message or ("hackager: update " + ", ".join(changed[:6])
                           + (f" (+{len(changed) - 6} more)" if len(changed) > 6 else ""))
    res = subprocess.run(["git", "-C", str(path), "commit", "-q", "-m", msg],
                         capture_output=True, text=True, env=git_env())
    if res.returncode != 0:
        print(res.stderr.strip(), file=sys.stderr)
        return 1
    print(f"committed: {git(path, ['log', '-1', '--format=%h %s'])}")
    return 0


# ---------------------------------------------------------------------------
# verify: the project's OWN checks -- its tests, its build, its README --
# not the six board gates. Stored under INTERNALS keyed by HEAD so `next`
# can tell a passing verify from a stale one without re-running tests.

def code_head(path):
    """The last commit that touched CODE -- anything outside docs/ and the
    manifest. verify and review are keyed on this, not HEAD: on the first
    drive-through a docs-only `commit` moved HEAD and the loop re-ran the
    tests and paid for a second review with nothing changed."""
    return git(path, ["log", "-1", "--format=%h %ct", "--", ".", ":(exclude)docs",
                      f":(exclude){MANIFEST}"])


def verify_project(proj, timeout=600):
    path = Path(proj["path"])
    checks = {}
    # The previous result, read WITHOUT the staleness check last_verify
    # applies. A score baseline has to outlive the code change it is meant to
    # catch: dropping it whenever HEAD moves would discard the number exactly
    # when a regression became possible.
    try:
        last = json.loads((INTERNALS / f"{proj['name']}-verify.json").read_text())
    except (OSError, json.JSONDecodeError):
        last = {}
    readme = (path / "README.md").read_text(errors="replace") if (path / "README.md").is_file() else ""
    checks["readme_setup"] = bool(re.search(r"^#+.*(setup|install|getting started|prerequisite)", readme, re.I | re.M))
    checks["readme_run"] = bool(re.search(r"^#+.*(run|start|usage|quick ?start)", readme, re.I | re.M))
    checks["license"] = proj["license"]
    checks["gitignore"] = (path / ".gitignore").is_file()
    # No rules_doc/brief_doc here: those are hackager's own bookkeeping, and
    # `next` handles them. Fed into `review` as checks, a missing BRIEF on a
    # project that was built before `build` existed read as a blocking gap.
    # What the project itself says its build/test commands are.
    cmds = []
    pkg = path / "package.json"
    if pkg.is_file():
        try:
            scripts = json.loads(pkg.read_text()).get("scripts", {})
        except json.JSONDecodeError:
            scripts = {}
        if "build" in scripts:
            cmds.append(("build", ["npm", "run", "build"]))
        if "test" in scripts:
            cmds.append(("test", ["npm", "test"]))
        # A project that declares a quality gate gets it run. Not hackager's
        # opinion of clean code -- the project's own, in its own words. Three
        # of six real projects here declare `typecheck` or `check` and
        # verify never ran them, so "verify: pass" was quieter than the repo.
        for name in ("typecheck", "lint", "check", "format:check", "fmt:check"):
            if name in scripts:
                cmds.append((name.replace(":", "_"), ["npm", "run", name]))
    if (path / "Cargo.toml").is_file():
        cmds.append(("test", ["cargo", "test", "-q"]))
    if (path / "go.mod").is_file():
        cmds.append(("test", ["go", "test", "./..."]))
    if (path / "pyproject.toml").is_file() or list(path.glob("tests/test_*.py")):
        # Through the project's own runner, not bare system python. Averis
        # locks its deps with uv, so `python3 -m pytest` found no pytest at
        # all and verify reported FAILED for a suite of 129 tests that pass
        # -- calling a good build broken, which is the worst direction for a
        # checker to be wrong in.
        def py_tool(tool, *args):
            """The project's own way of running `tool`, or None if it has none.

            None means SKIP, not fail. A tool the project never installed is
            not a failing gate -- reporting `lint FAILED: command not found`
            is the same false-failure that made verify call a passing suite
            broken, and it would be worse here because it fires on projects
            that never asked for a linter."""
            if (path / "uv.lock").is_file() and shutil.which("uv"):
                return ["uv", "run", tool, *args]
            if (path / "poetry.lock").is_file() and shutil.which("poetry"):
                return ["poetry", "run", tool, *args]
            local = path / ".venv" / "bin" / tool
            if local.is_file():
                return [str(local), *args]
            if shutil.which(tool):
                return [tool, *args]
            return None

        if runner := py_tool("pytest", "-q"):
            cmds.append(("test", runner))
        # The quality gates this project declares for itself, same principle
        # as reading package.json scripts for node. Missed before: a Python
        # project's gates live in pyproject.toml sections, not in a scripts
        # table, so verify ran tests only and reported green on a tree with
        # seven real ruff violations in it.
        pyproject = read_if(path / "pyproject.toml", 20000)
        if "[tool.ruff" in pyproject:
            for name, argv in (("lint", ("ruff", "check", ".")),
                               ("format", ("ruff", "format", "--check", "."))):
                if cmd := py_tool(*argv):
                    cmds.append((name, cmd))
        if "[tool.mypy" in pyproject and (cmd := py_tool("mypy")):
            cmds.append(("typecheck", cmd))
    # If the project has a grader and something to grade, score is a gate too.
    # It was not, and that is how a scored entry can rot: tests, lint, format
    # and typecheck all stay green while a classifier change quietly costs
    # real points, because the one number the event actually judges was
    # measured once by hand and never checked again.
    sub = path / "submission.json"
    if sub.is_file():
        score_cmd, _ = score_plan({"path": str(path)})
        if score_cmd:
            cmds.append(("score", [str(sub) if c == "SUBMISSION_PATH" else c
                                   for c in score_cmd]))

    checks["has_tests"] = any(k == "test" for k, _ in cmds)
    runs = []
    for kind, cmd in cmds:
        # A grader lives with its own imports and relative data paths, so it
        # runs from its own directory; everything else runs from the project.
        cwd = str(Path(cmd[1]).parent) if kind == "score" else str(path)
        try:
            r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
            out = r.stdout + r.stderr
            ok, tail = r.returncode == 0, out.strip().splitlines()[-15:]
        except (subprocess.SubprocessError, OSError) as e:
            out, ok, tail = "", False, [str(e)]
        entry = {"kind": kind, "cmd": " ".join(cmd), "ok": ok, "tail": tail}
        if kind == "score" and ok:
            # A grader reports; it does not judge. score_cli.py exits 0 whether
            # the entry scores 1.0 or 0.1, so "it ran" is not a gate -- a
            # deliberate 30-entry regression passed this check until the number
            # itself was read. Compare against the last recorded score and fail
            # on any drop; the first run has nothing to compare and just records.
            m = re.search(r"FINAL SCORE\s+([0-9.]+)", out)
            if m:
                entry["score"] = float(m.group(1))
                prev = (last or {}).get("score")
                if prev is not None and entry["score"] < prev - 1e-9:
                    ok = False
                    entry["tail"] = [f"score dropped {prev:.4f} -> {entry['score']:.4f}"] + tail
        runs.append(entry)
        checks[f"{kind}_passes"] = ok
    result = {"head": code_head(path), "checks": checks, "runs": runs,
              "at": datetime.now().isoformat(timespec="seconds")}
    # Carry the score forward at the top level: the baseline the next run
    # compares against, kept even when this run did not score, so a project
    # that temporarily loses its grader does not silently lose its floor.
    scored = next((r["score"] for r in runs if r.get("score") is not None), None)
    if scored is not None or last.get("score") is not None:
        result["score"] = scored if scored is not None else last["score"]
    INTERNALS.mkdir(exist_ok=True)
    (INTERNALS / f"{proj['name']}-verify.json").write_text(json.dumps(result, indent=2))
    return result


def last_verify(proj):
    f = INTERNALS / f"{proj['name']}-verify.json"
    if not f.is_file():
        return None
    try:
        r = json.loads(f.read_text())
    except json.JSONDecodeError:
        return None
    if r.get("head") != code_head(Path(proj["path"])):
        return None  # stale: the code moved since
    return r


def verify_ok(result):
    if not result:
        return False
    c = result["checks"]
    must = ["readme_setup", "readme_run", "license", "has_tests"]
    must += [k for k in c if k.endswith("_passes")]
    return all(c.get(k) for k in must)


def cmd_verify(args):
    proj = scan_project(Path(args.project).expanduser())
    result = verify_project(proj, args.timeout)
    ok = verify_ok(result)
    if args.json:  # JSON only -- see cmd_doctor
        print(json.dumps({**result, "pass": ok}, indent=2))
        return 0 if ok else 1
    for k, v in result["checks"].items():
        print(f"  {'ok ' if v else 'MISSING'}  {k}")
    for r in result["runs"]:
        print(f"-- {r['cmd']}: {'ok' if r['ok'] else 'FAILED'}")
        if not r["ok"]:
            print("   " + "\n   ".join(r["tail"]))
    print("verify: " + ("pass" if ok else "fail"))
    return 0 if ok else 1


